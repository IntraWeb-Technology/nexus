# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files and secrets (never commit)
.env
.env.*
!.env.example
!**/.env.example
.env*.local
.mcp.json

# Monorepo apps (Next.js / Strapi local env)
apps/**/.env
apps/**/.env.*
!apps/**/.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build outputs
.next/
out/
build
dist
*.tsbuildinfo

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc / OS
.DS_Store
Thumbs.db
*.pem
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
hostinger_ci_rsa
hostinger_ci_rsa.pub

# Local staging / ops scratch (SSH keys, compose experiments, etc.)
tmp/
.tmp/

# Affected-detection local dump (CI also writes this under GITHUB_WORKSPACE)
affected-result.json

# Ephemeral Strapi build-check tree (duplicate package name; never publish)
apps/_cms-strapi-build-check/

# Supabase CLI link cache for apps/iw-portal
apps/iw-portal/supabase/.temp/

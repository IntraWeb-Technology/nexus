HOST=0.0.0.0
PORT=1337

# Generate real secrets with `npx openssl rand -base64 32` (or the Strapi
# CLI prompts on first `strapi develop`). Never commit real values.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Database -----------------------------------------------------------
# DATABASE_CLIENT selects the driver used by config/database.ts:
# "sqlite" (default, local dev) | "postgres" (prod / cms.intrawebtech.com) | "mysql"

# Dev (default): SQLite file at apps/cms-strapi/.tmp/data.db
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Prod: PostgreSQL. Uncomment and fill in when DATABASE_CLIENT=postgres.
# Requires the `pg` package (see package.json / README).
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@host:5432/database
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SCHEMA=public
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000

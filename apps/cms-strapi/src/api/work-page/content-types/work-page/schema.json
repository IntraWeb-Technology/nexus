{
  "kind": "collectionType",
  "collectionName": "work_pages",
  "info": {
    "singularName": "work-page",
    "pluralName": "work-pages",
    "displayName": "Work Page",
    "description": "Atlas site-scoped Work index chrome"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "site": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::site.site",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true
    },
    "intro": {
      "type": "component",
      "repeatable": false,
      "component": "work.intro",
      "required": true
    },
    "featuredProject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "required": true
    },
    "featuredCopy": {
      "type": "component",
      "repeatable": false,
      "component": "work.featured-copy",
      "required": true
    },
    "selectedChapter": {
      "type": "string",
      "required": true
    },
    "selectedHeadline": {
      "type": "string",
      "required": true
    },
    "selectedDeck": {
      "type": "text",
      "required": true
    },
    "taxonomy": {
      "type": "component",
      "repeatable": false,
      "component": "work.taxonomy",
      "required": true
    },
    "contactBridge": {
      "type": "component",
      "repeatable": false,
      "component": "home.bridge",
      "required": true
    }
  }
}

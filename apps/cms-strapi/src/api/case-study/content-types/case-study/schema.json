{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study",
    "description": "Client and portfolio case studies"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "clientName": {
      "type": "string"
    },
    "summary": {
      "type": "text"
    },
    "challenge": {
      "type": "richtext"
    },
    "solution": {
      "type": "richtext"
    },
    "results": {
      "type": "richtext"
    },
    "technologies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::technology.technology"
    },
    "relatedProject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "migrationBatch": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "stackLine": {
      "type": "string"
    },
    "deck": {
      "type": "text"
    },
    "deckTablet": {
      "type": "text"
    },
    "deckMobile": {
      "type": "text"
    },
    "heroMeta": {
      "type": "component",
      "repeatable": true,
      "component": "publishing.meta-item"
    },
    "metaLineTablet": {
      "type": "string"
    },
    "metaLineMobileYear": {
      "type": "string"
    },
    "metaLineMobileRole": {
      "type": "string"
    },
    "toc": {
      "type": "json"
    },
    "overview": {
      "type": "component",
      "repeatable": false,
      "component": "case.overview"
    },
    "problem": {
      "type": "component",
      "repeatable": false,
      "component": "case.prose-section"
    },
    "constraints": {
      "type": "component",
      "repeatable": false,
      "component": "case.row-section"
    },
    "architecture": {
      "type": "component",
      "repeatable": false,
      "component": "case.architecture"
    },
    "decisions": {
      "type": "component",
      "repeatable": true,
      "component": "case.decision"
    },
    "implementation": {
      "type": "component",
      "repeatable": false,
      "component": "case.prose-section"
    },
    "delivery": {
      "type": "component",
      "repeatable": false,
      "component": "case.row-section"
    },
    "outcomes": {
      "type": "component",
      "repeatable": false,
      "component": "case.outcomes"
    },
    "lessons": {
      "type": "component",
      "repeatable": false,
      "component": "case.row-section"
    },
    "figureSlots": {
      "type": "component",
      "repeatable": true,
      "component": "case.figure-slot"
    },
    "relatedNote": {
      "type": "text"
    },
    "contactBridge": {
      "type": "component",
      "repeatable": false,
      "component": "home.bridge"
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Blog and long-form articles"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "contentFormat": {
      "type": "enumeration",
      "enum": [
        "markdown",
        "mdx",
        "blocks",
        "html"
      ],
      "default": "markdown",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "originalSource": {
      "type": "string"
    },
    "originalUrl": {
      "type": "string"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "hashnodeId": {
      "type": "string"
    },
    "hashnodePublication": {
      "type": "string"
    },
    "publishedDate": {
      "type": "datetime"
    },
    "updatedDate": {
      "type": "datetime"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "migrationBatch": {
      "type": "string"
    },
    "surface": {
      "type": "enumeration",
      "enum": [
        "writing",
        "documentation"
      ],
      "default": "writing",
      "required": true
    },
    "editorialType": {
      "type": "enumeration",
      "enum": [
        "essay",
        "decision",
        "note"
      ]
    },
    "docKind": {
      "type": "enumeration",
      "enum": [
        "guide",
        "adr",
        "playbook",
        "procedure",
        "reference"
      ]
    },
    "readingTime": {
      "type": "string"
    },
    "dek": {
      "type": "text"
    },
    "dekCompact": {
      "type": "text"
    },
    "headerChapter": {
      "type": "string"
    },
    "headerMeta": {
      "type": "component",
      "repeatable": true,
      "component": "publishing.meta-item"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "publishing.section"
    },
    "contactBridge": {
      "type": "component",
      "repeatable": false,
      "component": "home.bridge"
    }
  }
}

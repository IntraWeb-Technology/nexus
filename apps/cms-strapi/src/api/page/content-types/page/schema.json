{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Editable marketing pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "required": true
    },
    "pageType": {
      "type": "enumeration",
      "enum": ["home", "about", "contact", "services", "work", "blog", "legal", "custom"],
      "default": "custom"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero",
        "blocks.rich-text",
        "blocks.cta",
        "blocks.faq-section",
        "blocks.media",
        "blocks.stats"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}

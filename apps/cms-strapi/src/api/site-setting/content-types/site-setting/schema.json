{
  "kind": "collectionType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings",
    "description": "Per-site SEO, logos, contact, and navigation"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "site": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::site.site",
      "required": true
    },
    "siteName": {
      "type": "string",
      "required": true
    },
    "siteDescription": {
      "type": "text"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "contactInformation": {
      "type": "component",
      "repeatable": false,
      "component": "shared.contact-information"
    },
    "headerNavigation": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::navigation.navigation"
    },
    "footerNavigation": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::navigation.navigation"
    }
  }
}

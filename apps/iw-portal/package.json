{
  "name": "@repo/iw-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:test": "tsx scripts/seed-test-client.ts",
    "upsert:jschibelli": "tsx scripts/upsert-jschibelli-portal.ts",
    "db:apply-schema": "tsx scripts/apply-portal-schema-postgres.ts",
    "db:link": "pnpm exec supabase link --project-ref wvjwibsomjecolcigjgr",
    "db:push": "pnpm exec supabase db push",
    "db:pull": "pnpm exec supabase db pull",
    "db:push:self-hosted": "tsx scripts/self-host/db-push-self-hosted.ts",
    "self-host:bootstrap-docs": "echo Run bootstrap-supabase-vps.sh ON the Hostinger VPS — see docs/architecture/supabase-self-host-hostinger.md",
    "hubspot:ensure-co-properties": "tsx scripts/hubspot/ensure-change-order-properties.ts",
    "hubspot:ensure-reactivation-contact-properties": "tsx scripts/hubspot/ensure-reactivation-contact-properties.ts",
    "hubspot:ensure-subscription-deal-properties": "tsx scripts/hubspot/ensure-subscription-deal-properties.ts",
    "hubspot:ensure-co-form": "tsx scripts/hubspot/ensure-change-order-form.ts",
    "hubspot:update-co-form": "tsx scripts/hubspot/update-change-order-form.ts",
    "stripe:setup-maintenance-products": "tsx scripts/setup-maintenance-products.ts",
    "test": "tsx --test src/lib/webhooks/provision-client-idempotency.test.ts src/lib/privacy/classify-deletion-tier.test.ts src/lib/social-ops/social-ops.test.ts",
    "verify:stack": "pnpm --filter @repo/ops diagnostics:verify-stack",
    "vercel:align-env": "pnpm --filter @repo/ops vercel:align-env",
    "vercel:prune-dev-env": "pnpm --filter @repo/ops vercel:prune-dev-env"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.4",
    "@clerk/nextjs": "^7.0.8",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "next": "16.2.2",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0",
    "stripe": "^22.0.0",
    "svix": "^1.90.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/env": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "pg": "^8.20.0",
    "supabase": "^2.84.10",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}

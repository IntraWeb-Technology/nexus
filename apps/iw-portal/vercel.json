{
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@repo/iw-portal",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "portal.intrawebtech.com" }],
      "destination": "/:path*"
    }
  ]
}

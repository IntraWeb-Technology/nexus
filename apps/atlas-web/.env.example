# Atlas web — local / preview environment (server-only)

# ---------------------------------------------------------------------------
# Content source (fixture | strapi)
# ---------------------------------------------------------------------------
# Force mode: fixture (local/e2e/demo) or strapi (CMS).
# If unset: strapi when STRAPI_URL / STRAPI_API_URL is set; otherwise fixture.
# Production must declare its content-source mode. Fixture mode is not proof of live CMS delivery.
ATLAS_CONTENT_SOURCE=

# Strapi (site tenancy key is hard-coded to `personal` in atlas-web —
# tags are not tenancy). Required when ATLAS_CONTENT_SOURCE=strapi or when
# STRAPI_URL / STRAPI_API_URL is set.
# Server-only — never use NEXT_PUBLIC_ for Strapi URLs or tokens.
STRAPI_URL=
# Alias accepted by the client:
STRAPI_API_URL=
STRAPI_API_TOKEN=
# Optional preview/draft reads (shared with cms-strapi PREVIEW_SECRET)
STRAPI_PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Contact form delivery (Resend) — never use NEXT_PUBLIC_ for these
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_EMAIL=
# Optional From override (defaults to Resend onboarding sender in local)
RESEND_FROM=

# Set true for local/e2e when Resend is not configured (skips real send)
CONTACT_INSECURE_SKIP_SEND=

{
  "name": "@repo/atlas-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3020",
    "build": "next build",
    "start": "next start --port 3020",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "node --import tsx --test src/lib/strapi/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --grep-invert \"visual regression\"",
    "test:e2e:update": "playwright test --update-snapshots=changed"
  },
  "dependencies": {
    "@repo/strapi-client": "workspace:*",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}

      },
      "id": "sys08-warn",
      "name": "Send Warning",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1584,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nreturn [{\n  json: {\n    systemPrompt: 'Write a weekly client update email for IntraWeb Technologies. Tone: direct, professional, no filler. Sections: What we did this week, What\\'s next, Items needed from you. Return a BODY FRAGMENT only: use <p>, <ul>/<li>, <strong> as needed. Do NOT output <!DOCTYPE>, <html>, <head>, or <body>. No markdown, no backticks. Use inline hex colors only (no CSS variables): primary text #0f1419, muted #475569, links and emphasis #0d9488.',\n    userPrompt: `Client: ${d.clientName}\\nTier: ${d.tier}\\nDeal stage: ${d.dealStage}\\nRecent activity: ${d.noRecentActivity ? 'No logged activity this week' : 'Activity logged this week'}\\n\\nWrite a professional weekly update email.`,\n    maxTokens: 2000\n  }\n}];"
      },
      "id": "sys08-claude-prep",
      "name": "Prep Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst now = new Date().toISOString();\nconst trigger = raw.workflowName !== undefined || raw.contactName !== undefined ? raw : (raw.input1 || raw.input2 || {});\nconst w = trigger.workflowName || trigger.workflow || '';\nconst c = trigger.contactName || trigger.contact || trigger.name || '';\nconst p = trigger.phone || trigger.phoneNumber || '';\nconst e = trigger.eventType || trigger.event || '';\nconst s = trigger.status || 'success';\nconst n = trigger.notes || trigger.note || '';\nconst wf = (typeof w === 'string' && w.trim()) ? w : 'Unknown';\nconst cn = typeof c === 'string' ? c : (c ? String(c) : '');\nconst ph = typeof p === 'string' ? p : (p ? String(p) : '');\nconst ev = (typeof e === 'string' && e.trim()) ? e : 'unknown';\nconst st = (typeof s === 'string' && s.trim()) ? s : 'success';\nconst no = typeof n === 'string' ? n : (n ? String(n) : '');\nfunction esc(x) { return String(x ?? '').replace(/'/g, \"''\"); }\nconst _sql = \"INSERT INTO public.os_automation_log (workflow_name, contact_name, phone, event_type, status, notes) VALUES ('\" + esc(wf) + \"','\" + esc(cn) + \"','\" + esc(ph) + \"','\" + esc(ev) + \"','\" + esc(st) + \"','\" + esc(no) + \"');\";\nreturn [{ json: { Timestamp: now, 'Workflow Name': wf, 'Contact Name': cn, Phone: ph, 'Event Type': ev, Status: st, Notes: no, _sql } }];"
      },
      "id": "sw-log-prepare",
      "name": "Prepare Row Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Prepare Row Data').first().json;\nreturn [{\n  json: {\n    success: true,\n    data: { logged: true, timestamp: prep['Timestamp'] || new Date().toISOString() },\n    error: null\n  }\n}];"

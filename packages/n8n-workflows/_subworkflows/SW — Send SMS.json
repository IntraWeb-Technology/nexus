      "parameters": {
        "jsCode": "// Config from previous node (Get Config) to avoid 'Referenced node doesn't exist'\nconst config = $input.first().json;\nlet input;\ntry {\n  input = $('Execute Workflow Trigger').first().json;\n} catch (e) {\n  input = $('When executed by another node').first().json;\n}\n\nconst twilioFrom = String(config.twilio?.fromNumber || '').trim();\nif (!twilioFrom) {\n  throw new Error('CONFIG.twilio.fromNumber is empty — set your Twilio Messaging E.164 sender in CONFIG (Return Config). Do not use owner.phone as From; Twilio rejects non-Twilio numbers.');\n}\n\nreturn [{\n  json: {\n    to: input.to,\n    body: input.body,\n    from: twilioFrom,\n    workflowName: input.workflowName || 'SW: Send SMS'\n  }\n}];"

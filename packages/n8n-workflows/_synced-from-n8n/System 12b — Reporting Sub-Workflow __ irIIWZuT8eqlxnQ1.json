    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.HUBSPOT_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"dealstage\",\n          \"operator\": \"EQ\",\n          \"value\": \"invoicesent\"\n        },\n        {\n          \"propertyName\": \"hs_lastmodifieddate\",\n          \"operator\": \"LT\",\n          \"value\": \"{{$now.minus(30, 'days').toMillis()}}\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"dealname\", \"amount\", \"dealstage\", \"hs_lastmodifieddate\", \"closedate\"],\n  \"limit\": 50\n}",
        "options": {}
      },
      "id": "58ff91a7-46b8-4298-b9c6-bc42f9fd9b0f",
      "name": "HubSpot: Get Overdue Invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const deals = $input.first().json.results || [];\nif (deals.length === 0) {\n  return [{ json: { message: '*Overdue Invoices*\\n\\nNo overdue invoices found.' } }];\n}\nconst now = Date.now();\nconst lines = deals.map(d => {\n  const p = d.properties;\n  const modDate = new Date(p.hs_lastmodifieddate);\n  const daysOverdue = Math.floor((now - modDate.getTime()) / (1000 * 60 * 60 * 24));\n  const amount = parseFloat(p.amount || 0);\n  return `• ${p.dealname} — $${amount.toLocaleString()} — ${daysOverdue} days overdue`;\n});\nreturn [{\n  json: {\n    message: `*Overdue Invoices (${deals.length})*\\n\\n${lines.join('\\n')}`\n  }\n}];"
      },

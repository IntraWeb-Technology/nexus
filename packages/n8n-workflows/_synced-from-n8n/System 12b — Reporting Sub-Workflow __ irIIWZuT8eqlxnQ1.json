        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"hs_task_status\",\n          \"operator\": \"EQ\",\n          \"value\": \"NOT_STARTED\"\n        },\n        {\n          \"propertyName\": \"hs_timestamp\",\n          \"operator\": \"LT\",\n          \"value\": \"{{$now.plus(7, 'days').toMillis()}}\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"hs_task_subject\", \"hs_task_body\", \"hs_timestamp\", \"hs_task_priority\", \"hs_task_status\"],\n  \"sorts\": [{\"propertyName\": \"hs_timestamp\", \"direction\": \"ASCENDING\"}],\n  \"limit\": 20\n}",
        "options": {}
      },
      "id": "f4e7a351-4f6a-4f35-a2c2-d4ec6cb2a0b0",
      "name": "HubSpot: Get Due Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        656
      ]
    },
    {
      "parameters": {
        "jsCode": "const tasks = $input.first().json.results || [];\nif (tasks.length === 0) {\n  return [{ json: { message: '*Tasks Due This Week*\\n\\nNo open tasks due in the next 7 days.' } }];\n}\nconst lines = tasks.map(t => {\n  const p = t.properties;\n  const due = p.hs_timestamp ? new Date(p.hs_timestamp).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) : 'No date';\n  const priority = p.hs_task_priority || 'NONE';\n  return `• [${priority}] ${p.hs_task_subject} — Due: ${due}`;\n});\nreturn [{\n  json: {\n    message: `*Tasks Due This Week (${tasks.length})*\\n\\n${lines.join('\\n')}`\n  }\n}];"
      },

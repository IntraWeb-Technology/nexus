      "id": "f7bc9e26-f95c-4887-b1d9-000556dee7d8",
      "name": "HubSpot: Get All Deals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const deals = ($input.first().json.results || []);\nconst stageMap = {};\ndeals.forEach(d => {\n  const stage = d.properties.dealstage || 'unknown';\n  const amount = parseFloat(d.properties.amount || 0);\n  if (!stageMap[stage]) stageMap[stage] = { count: 0, total: 0 };\n  stageMap[stage].count++;\n  stageMap[stage].total += amount;\n});\nconst lines = Object.entries(stageMap).map(([stage, data]) => {\n  return `• ${stage}: ${data.count} deal(s) — $${data.total.toLocaleString()}`;\n});\nconst grandTotal = deals.reduce((sum, d) => sum + parseFloat(d.properties.amount || 0), 0);\nreturn [{\n  json: {\n    message: `*Pipeline Status*\\n\\n${lines.join('\\n')}\\n\\n*Total Pipeline Value: $${grandTotal.toLocaleString()}*`\n  }\n}];"
      },

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.HUBSPOT_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"createdate\",\n          \"operator\": \"GT\",\n          \"value\": \"{{$now.minus(7, 'days').toMillis()}}\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"firstname\", \"lastname\", \"email\", \"company\", \"createdate\", \"hs_lead_status\", \"hubspotscore\"],\n  \"sorts\": [{\"propertyName\": \"hubspotscore\", \"direction\": \"DESCENDING\"}],\n  \"limit\": 20\n}",
        "options": {}
      },
      "id": "6087513e-35fc-46c0-9f93-9e5c49225b94",
      "name": "HubSpot: Get Leads This Week",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first().json.results || [];\nconst top3 = results.slice(0, 3);\nconst lines = top3.map((c, i) => {\n  const p = c.properties;\n  const name = `${p.firstname || ''} ${p.lastname || ''}`.trim() || 'Unknown';\n  const score = p.hubspotscore || 'N/A';\n  const company = p.company || 'N/A';\n  return `${i + 1}. ${name} — ${company} | Score: ${score} | Status: ${p.hs_lead_status || 'N/A'}`;\n});\nconst total = $input.first().json.total || results.length;\nreturn [{\n  json: {\n    message: `*Leads This Week (${total} total)*\\n\\nTop by lead score:\\n${lines.join('\\n') || 'No leads this week'}`\n  }\n}];"
      },

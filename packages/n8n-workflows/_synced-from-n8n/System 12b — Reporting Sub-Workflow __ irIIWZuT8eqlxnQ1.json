      "id": "12a9550c-9849-480d-ab59-bdcdbee70ac2",
      "name": "Sheets: Get Revenue Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        816
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.values || [];\nif (rows.length < 2) {\n  return [{ json: { message: '*Revenue This Month*\\n\\nNo revenue data found in the Revenue sheet.' } }];\n}\nconst now = new Date();\nconst currentMonth = now.getMonth();\nconst currentYear = now.getFullYear();\nconst headers = rows[0];\nconst dataRows = rows.slice(1);\nconst monthRows = dataRows.filter(row => {\n  const dateStr = row[0];\n  if (!dateStr) return false;\n  const d = new Date(dateStr);\n  return d.getMonth() === currentMonth && d.getFullYear() === currentYear;\n});\nlet totalInvoiced = 0;\nlet totalCollected = 0;\nmonthRows.forEach(row => {\n  totalInvoiced += parseFloat(row[1] || 0);\n  totalCollected += parseFloat(row[2] || 0);\n});\nreturn [{\n  json: {\n    message: `*Revenue This Month*\\n\\nInvoiced: $${totalInvoiced.toLocaleString()}\\nCollected: $${totalCollected.toLocaleString()}\\nOutstanding: $${(totalInvoiced - totalCollected).toLocaleString()}\\n\\nTransactions this month: ${monthRows.length}`\n  }\n}];"
      },

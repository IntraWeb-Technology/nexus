      "id": "fd8d1620-d9c5-432e-9229-daec4bd21cf9",
      "name": "HubSpot: Get Client Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        496
      ]
    },
    {
      "parameters": {
        "jsCode": "const deals = $input.first().json.results || [];\nconst withScores = deals.filter(d => d.properties.client_health_score);\nif (withScores.length === 0) {\n  return [{ json: { message: '*Client Health Scores*\\n\\nNo health scores found. Make sure client_health_score property is populated in HubSpot.' } }];\n}\nconst sorted = withScores.sort((a, b) => parseFloat(a.properties.client_health_score) - parseFloat(b.properties.client_health_score));\nconst lines = sorted.map(d => {\n  const p = d.properties;\n  const score = parseFloat(p.client_health_score);\n  const emoji = score >= 8 ? 'green' : score >= 5 ? 'yellow' : 'red';\n  return `• [${emoji.toUpperCase()}] ${p.dealname} — Score: ${score}/10`;\n});\nreturn [{\n  json: {\n    message: `*Client Health Scores (${withScores.length} clients)*\\n\\n${lines.join('\\n')}`\n  }\n}];"
      },

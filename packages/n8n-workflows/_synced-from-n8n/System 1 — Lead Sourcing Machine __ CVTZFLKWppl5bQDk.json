    {
      "parameters": {
        "jsCode": "// Merge phone and website check results to determine if contact exists\nconst phoneCheckResult = $('Check HubSpot by Phone').item.json;\nconst websiteCheckResult = $('Check HubSpot by Website').item.json;\nconst lead = $('Score and Filter Leads').item.json;\n\nconst phoneExists = (phoneCheckResult.total || 0) > 0;\nconst websiteExists = (websiteCheckResult.total || 0) > 0 && lead.website && lead.website.length > 0;\n\nreturn [{\n  json: {\n    ...lead,\n    already_exists: phoneExists || websiteExists,\n    phone_match: phoneExists,\n    website_match: websiteExists\n  }\n}];"
      },

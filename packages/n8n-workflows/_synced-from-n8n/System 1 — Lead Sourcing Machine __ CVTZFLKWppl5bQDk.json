    {
      "parameters": {
        "jsCode": "// Build a true end-of-run summary after Split In Batches finishes.\nconst safeAll = (nodeName) => {\n  try {\n    return $(nodeName).all();\n  } catch {\n    return [];\n  }\n};\n\nconst queries = safeAll('Define Search Queries');\nconst scoredItems = safeAll('Score and Filter Leads');\nconst appendedItems = safeAll('Append to Leads Sheet');\nconst duplicateChecks = safeAll('Evaluate Duplicate Check');\n\nconst emptyIndustries = scoredItems.filter(item => item.json.skip === true).length;\nconst qualifyingLeads = scoredItems.filter(item => item.json.skip !== true).length;\nconst duplicateLeads = duplicateChecks.filter(item => item.json.already_exists === true).length;\nconst newLeadsAdded = appendedItems.length;\n\nconst summary = {\n  run_date: new Date().toISOString(),\n  queries_processed: queries.length,\n  industries_with_no_results: emptyIndustries,\n  qualifying_leads_found: qualifyingLeads,\n  duplicates_skipped: duplicateLeads,\n  new_leads_added: newLeadsAdded,\n  message: `Lead sourcing run complete. ${newLeadsAdded} new leads added to HubSpot and Google Sheets.`\n};\n\nreturn [{ json: summary }];"
      },

    },
    {
      "parameters": {
        "jsCode": "// Merge Place Details result with industry from Expand Results\nconst raw = $input.item.json;\nconst result = raw.result || raw;\nconst industry = $('Expand Results').item.json.industry;\nreturn [{ json: { ...result, industry } }];"
      },
      "id": "dda0bd0f-a41d-4a46-8266-668f95813df0",
      "name": "Merge Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -8528,
        1840
      ]
    },
    {
      "parameters": {
        "jsCode": "// Score each place (input is one item per place with full details from Place Details)\nconst items = $input.all();\nif (items.length === 0) {\n  return [{ json: { skip: true, industry: '', count: 0 } }];\n}\nconst industry = items[0].json.industry || '';\nconst scoredLeads = [];\n\nfor (const item of items) {\n  const place = item.json;\n  if (place.skip) continue;\n  let score = 0;\n  const reasons = [];\n\n  const reviewCount = place.user_ratings_total || 0;\n  if (reviewCount >= 10 && reviewCount <= 75) {\n    score += 2;\n    reasons.push('Review count 10-75 (+2)');\n  }\n\n  const website = place.website || '';\n  const hasSSL = website.startsWith('https://');\n  const hasWebsite = website.length > 0;\n  if (!hasWebsite || !hasSSL) {\n    score += 2;\n    reasons.push('No website or no SSL (+2)');\n  }\n\n  const rating = place.rating || 0;\n  if (rating >= 3.5 && rating <= 4.2) {\n    score += 1;\n    reasons.push('Rating 3.5-4.2 (+1)');\n  }\n\n  const phone = place.formatted_phone_number || '';\n  if (phone.length > 0) {\n    score += 1;\n    reasons.push('Phone present (+1)');\n  }\n\n  if (score >= 4) {\n    const address = place.formatted_address || '';\n    const addressParts = address.split(',');\n    const city = addressParts.length >= 2 ? addressParts[addressParts.length - 3]?.trim() || '' : '';\n    let normalizedPhone = phone.replace(/[^0-9]/g, '');\n    if (normalizedPhone.length === 10) normalizedPhone = '+1' + normalizedPhone;\n    else if (normalizedPhone.length === 11 && normalizedPhone.startsWith('1')) normalizedPhone = '+' + normalizedPhone;\n    else normalizedPhone = phone;\n    scoredLeads.push({\n      name: place.name,\n      phone: normalizedPhone,\n      phone_raw: phone,\n      website: website,\n      address: address,\n      city: city,\n      rating: rating,\n      review_count: reviewCount,\n      place_id: place.place_id,\n      industry: place.industry,\n      lead_score: score,\n      score_reasons: reasons.join(', '),\n      source: 'google_maps_scraper'\n    });\n  }\n}\n\nif (scoredLeads.length === 0) {\n  return [{ json: { skip: true, industry: industry, count: 0 } }];\n}\nreturn scoredLeads.map(lead => ({ json: lead }));"
      },

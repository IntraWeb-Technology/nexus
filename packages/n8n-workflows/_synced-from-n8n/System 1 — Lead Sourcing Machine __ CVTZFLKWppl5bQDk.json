    {
      "parameters": {
        "jsCode": "// Expand Text Search results to one item per place (max 10 per query to limit Place Details cost)\nconst industry = $('Split In Batches').item.json.industry;\nconst results = $input.item.json.results || [];\nconst limit = 10;\nconst items = results.slice(0, limit).map(place => ({\n  json: {\n    place_id: place.place_id,\n    name: place.name,\n    formatted_address: place.formatted_address || '',\n    rating: place.rating || 0,\n    user_ratings_total: place.user_ratings_total || 0,\n    industry\n  }\n}));\nif (items.length === 0) {\n  return [{ json: { skip: true, industry, count: 0 } }];\n}\nreturn items;"
      },

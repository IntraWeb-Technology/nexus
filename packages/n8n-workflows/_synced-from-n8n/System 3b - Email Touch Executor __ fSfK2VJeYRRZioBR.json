  "nodes": [
    {
      "parameters": {
        "content": "## README\nReusable email sub-workflow for Touch 1, 3, and 5.\n\nExpected input includes contact info, `touch_number`, Claude prompts, fallback subject/body, and HubSpot logging text.\n\nOptional sheet logging runs only when `should_log_to_sheet` is `true`.",
        "height": 220,
        "width": 420,
        "color": 5
      },
      "id": "08d6b8a7-8f6a-4bdb-8af8-e9381f0655cb",
      "name": "README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "f66d8d95-31a1-442c-a580-36bcbd581b08",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        224,
        352
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"system\": \"{{$json.ai_system_prompt}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{$json.ai_user_prompt}}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "46e39ffd-351d-47fc-8069-34439bca3741",
      "name": "Claude: Generate Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        448,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Execute Workflow Trigger').first().json;\nconst response = $input.first().json;\n\nlet subject = lead.default_subject || `Quick question about ${lead.company_name || 'your business'}`;\nlet bodyHtml = lead.default_body_html || `<p>Hi ${lead.first_name || 'there'},</p><p>Wanted to follow up.</p><p>- John, IntraWeb Technologies</p>`;\n\ntry {\n  const content = response.content?.[0]?.text;\n  if (content) {\n    const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    const parsed = JSON.parse(cleaned);\n    subject = parsed.subject || subject;\n    bodyHtml = parsed.body_html || bodyHtml;\n  }\n} catch (error) {\n  // Keep defaults if Claude returns malformed JSON.\n}\n\nreturn [{\n  json: {\n    ...lead,\n    email_subject: subject,\n    email_body_html: bodyHtml,\n    touch_count: lead.touch_number || lead.touch_count || 0\n  }\n}];"
      },
      "id": "c128a5a7-c61b-406a-b0bf-ff128f765439",
      "name": "Code: Parse Email Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        352
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"John <john@intrawebtech.com>\",\n  \"to\": [\"{{ $json.email }}\"],\n  \"subject\": \"{{ $json.email_subject }}\",\n  \"html\": \"{{ $json.email_body_html }}\"\n}",
        "options": {}
      },
      "id": "37a06b9a-3e59-4686-afbf-666ad409263c",

  "nodes": [
    {
      "parameters": {
        "content": "## README\nRuns after Touch 5 completes.\n\nMarks the HubSpot contact as sequence complete and appends the final Automations Log row in Google Sheets.",
        "height": 180,
        "width": 380,
        "color": 5
      },
      "id": "0e113351-95e0-4cdc-bc25-420b27104cc6",
      "name": "README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "30c9c181-0ec5-40c2-b35e-82744823843f",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        224,
        288
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{ $json.contact_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HUBSPOT_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"sequence_completed\": \"true\",\n    \"sequence_completed_date\": \"{{ $now.toISO() }}\"\n  }\n}",
        "options": {}
      },
      "id": "49a0cb76-bc43-471c-b19f-ea7888ffef9d",
      "name": "HubSpot: Mark Sequence Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        448,
        288
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $env.GOOGLE_SHEET_ID }}/values/Automations Log!A:Z:append",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "valueInputOption",
              "value": "USER_ENTERED"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GOOGLE_SHEETS_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"values\": [\n    [\n      \"{{ $now.toISO() }}\",\n      \"System 3 - Outbound Sequence\",\n      \"Completed\",\n      \"Full 5-touch sequence completed for {{ $json.contact_name }} at {{ $json.company_name }}\",\n      \"14-day sequence finished\"\n    ]\n  ]\n}",
        "options": {}
      },
      "id": "c25e406b-1268-4e0e-8ffa-3a5afeec4e0f",
      "name": "Sheets: Log Sequence Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        672,

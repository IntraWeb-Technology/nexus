      "id": "aabeb6c9-547b-40ed-9fcd-c26bdd48844a",
      "name": "Get Contacts Last Month",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Calculate lead counts and month-over-month deltas\nconst thisMonthData = $('Get Contacts This Month').item.json;\nconst lastMonthData = $('Get Contacts Last Month').item.json;\n\nconst thisMonthCount = thisMonthData.total || (thisMonthData.results || []).length;\nconst lastMonthCount = lastMonthData.total || (lastMonthData.results || []).length;\n\nconst delta = thisMonthCount - lastMonthCount;\nconst deltaPercent = lastMonthCount > 0\n  ? ((delta / lastMonthCount) * 100).toFixed(1)\n  : 'N/A';\n\nconst sources = {};\n(thisMonthData.results || []).forEach(contact => {\n  const source = contact.properties?.hs_analytics_source || 'Direct';\n  sources[source] = (sources[source] || 0) + 1;\n});\n\nreturn [{\n  json: {\n    thisMonthLeads: thisMonthCount,\n    lastMonthLeads: lastMonthCount,\n    monthDelta: delta,\n    deltaPercent,\n    sourceBreakdown: sources,\n    generatedAt: new Date().toISOString()\n  }\n}];\n"
      },
      "id": "d29b08a8-ab04-42b7-9a68-19e433434706",
      "name": "Calculate Lead Counts and Deltas",

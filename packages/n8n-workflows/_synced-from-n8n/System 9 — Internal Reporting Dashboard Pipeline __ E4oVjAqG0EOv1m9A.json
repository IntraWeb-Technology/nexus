    {
      "parameters": {
        "jsCode": "// Prepare pipeline data rows for Sheets\nconst pipelineResult = $('Group Deals by Stage').item.json;\nconst pipelineData = pipelineResult.pipelineData || [];\n\n// Build rows: headers + data\nconst headers = ['Deal Name', 'Stage', 'Value', 'Close Date', 'Days In Stage', 'Created Date', 'Updated At'];\nconst rows = [headers];\n\npipelineData.forEach(deal => {\n  rows.push([\n    deal.dealName,\n    deal.stage,\n    deal.amount.toString(),\n    deal.closeDate,\n    deal.daysInStage.toString(),\n    deal.createDate,\n    new Date().toISOString()\n  ]);\n});\n\n// Add stage summary rows\nrows.push([]);\nrows.push(['--- STAGE SUMMARY ---', '', '', '', '', '', '']);\nrows.push(['Stage', 'Deal Count', 'Total Value', '', '', '', '']);\n\n(pipelineResult.stageSummary || []).forEach(s => {\n  rows.push([s.stage, s.count.toString(), s.totalValue.toString(), '', '', '', '']);\n});\n\nreturn [{ json: { rows } }];\n"
      },

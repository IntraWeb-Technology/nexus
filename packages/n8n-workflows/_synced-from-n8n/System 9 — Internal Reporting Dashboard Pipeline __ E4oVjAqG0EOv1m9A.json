      "id": "8eba1b42-2932-4e06-a4fb-e8136efa4e05",
      "name": "Get Revenue Stage Deals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "// Calculate invoiced total, collected total, outstanding, and overdue\nconst response = $input.first().json;\nconst deals = response.results || [];\nconst now = new Date();\nconst thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);\n\nlet invoicedTotal = 0;\nlet collectedTotal = 0;\nlet outstandingTotal = 0;\nlet overdueTotal = 0;\nconst overdueDeals = [];\n\ndeals.forEach(deal => {\n  const stage = (deal.properties?.dealstage || '').toLowerCase();\n  const amount = parseFloat(deal.properties?.amount || 0);\n  const lastModified = deal.properties?.hs_lastmodifieddate\n    ? new Date(deal.properties.hs_lastmodifieddate)\n    : null;\n\n  if (stage === 'invoice_sent' || stage === 'invoicesent') {\n    invoicedTotal += amount;\n    outstandingTotal += amount;\n\n    // Check if overdue (invoice sent > 30 days ago)\n    if (lastModified && lastModified < thirtyDaysAgo) {\n      overdueTotal += amount;\n      overdueDeals.push({\n        dealId: deal.id,\n        dealName: deal.properties?.dealname || 'Unknown',\n        amount,\n        daysSinceInvoice: Math.floor((now - lastModified) / (1000 * 60 * 60 * 24))\n      });\n    }\n  } else if (stage === 'paid' || stage === 'closedwon') {\n    collectedTotal += amount;\n    invoicedTotal += amount;\n  }\n});\n\nreturn [{\n  json: {\n    invoicedTotal,\n    collectedTotal,\n    outstandingTotal,\n    overdueTotal,\n    overdueDeals,\n    overdueCount: overdueDeals.length,\n    generatedAt: now.toISOString()\n  }\n}];\n"
      },

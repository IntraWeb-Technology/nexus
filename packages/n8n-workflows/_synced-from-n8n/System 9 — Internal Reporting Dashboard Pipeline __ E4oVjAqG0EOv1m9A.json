        "jsCode": "// Format overdue invoice list for alert\nconst revenueData = $('Calculate Revenue Totals').item.json;\nconst overdueDeals = revenueData.overdueDeals || [];\n\nconst overdueList = overdueDeals\n  .map(d => `${d.dealName}: $${d.amount.toLocaleString()} (${d.daysSinceInvoice} days overdue)`)\n  .join('\\n');\n\nconst totalOverdue = revenueData.overdueTotal || 0;\n\nreturn [{\n  json: {\n    alertText: `🔴 OVERDUE INVOICES: ${overdueDeals.length} invoice(s) past 30 days\\n\\n${overdueList}\\n\\nTotal Outstanding: $${totalOverdue.toLocaleString()}`,\n    overdueList,\n    totalOverdue\n  }\n}];\n"

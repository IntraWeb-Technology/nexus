      "id": "3de07dba-92eb-4e9f-95c6-7d9d29952f1e",
      "name": "Get All Deals from HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Group deals by stage and calculate total values per stage\nconst response = $input.first().json;\nconst deals = response.results || [];\nconst now = new Date();\n\nconst stageGroups = {};\nconst pipelineData = [];\n\ndeals.forEach(deal => {\n  const stage = deal.properties?.dealstage || 'Unknown';\n  const amount = parseFloat(deal.properties?.amount || 0);\n  const createDate = deal.properties?.createdate ? new Date(deal.properties.createdate) : null;\n  const lastModified = deal.properties?.hs_lastmodifieddate ? new Date(deal.properties.hs_lastmodifieddate) : null;\n  const closeDate = deal.properties?.closedate || '';\n\n  const daysInStage = lastModified\n    ? Math.floor((now - lastModified) / (1000 * 60 * 60 * 24))\n    : 0;\n\n  if (!stageGroups[stage]) {\n    stageGroups[stage] = { count: 0, totalValue: 0, deals: [] };\n  }\n  stageGroups[stage].count++;\n  stageGroups[stage].totalValue += amount;\n  stageGroups[stage].deals.push(deal.id);\n\n  pipelineData.push({\n    dealId: deal.id,\n    dealName: deal.properties?.dealname || 'Unnamed',\n    stage,\n    amount,\n    closeDate,\n    daysInStage,\n    createDate: createDate ? createDate.toISOString() : ''\n  });\n});\n\n// Build stage summary\nconst stageSummary = Object.entries(stageGroups).map(([stage, data]) => ({\n  stage,\n  count: data.count,\n  totalValue: data.totalValue\n}));\n\nreturn [{\n  json: {\n    pipelineData,\n    stageSummary,\n    totalDeals: deals.length,\n    generatedAt: now.toISOString()\n  }\n}];\n"
      },

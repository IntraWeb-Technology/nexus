    {
      "parameters": {
        "jsCode": "// Prepare revenue tab data for current month\nconst revenueData = $('Calculate Revenue Totals').item.json;\nconst now = new Date();\nconst monthYear = `${now.getMonth() + 1}/${now.getFullYear()}`;\n\nconst rows = [\n  ['Month', 'Invoiced Total', 'Collected Total', 'Outstanding', 'Overdue Total', 'Overdue Count', 'Updated At'],\n  [\n    monthYear,\n    revenueData.invoicedTotal.toString(),\n    revenueData.collectedTotal.toString(),\n    revenueData.outstandingTotal.toString(),\n    revenueData.overdueTotal.toString(),\n    revenueData.overdueCount.toString(),\n    now.toISOString()\n  ]\n];\n\n// Add overdue deal details\nif (revenueData.overdueDeals && revenueData.overdueDeals.length > 0) {\n  rows.push([]);\n  rows.push(['--- OVERDUE INVOICES ---', '', '', '', '', '', '']);\n  rows.push(['Deal Name', 'Amount', 'Days Overdue', '', '', '', '']);\n  revenueData.overdueDeals.forEach(d => {\n    rows.push([d.dealName, d.amount.toString(), d.daysSinceInvoice.toString(), '', '', '', '']);\n  });\n}\n\nreturn [{ json: { rows, revenueData } }];\n"
      },

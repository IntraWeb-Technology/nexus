      "id": "02453b00-4e65-4534-a3fe-f6cb073ee0dc",
      "name": "Get Active HubSpot Deals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1328,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Filter deals to only active client deals (not leads, not closed)\nconst response = $input.first().json;\nconst deals = response.results || [];\n\n// Active client stages — adjust stage IDs to match your HubSpot pipeline\nconst activeClientStages = [\n  'active_client',\n  'onboarding',\n  'in_progress',\n  'delivery',\n  'active',\n  'contracted',\n  'client'\n];\n\nconst activeDeals = deals.filter(deal => {\n  const stage = (deal.properties?.dealstage || '').toLowerCase();\n  return activeClientStages.some(s => stage.includes(s));\n});\n\nif (activeDeals.length === 0) {\n  // Return all non-closed deals as fallback\n  return deals.map(d => ({ json: d }));\n}\n\nreturn activeDeals.map(d => ({ json: d }));\n"
      },
      "id": "7cde88f0-3eed-4017-b85c-2d0bc60cde83",
      "name": "Filter Active Client Deals",
      "type": "n8n-nodes-base.code",

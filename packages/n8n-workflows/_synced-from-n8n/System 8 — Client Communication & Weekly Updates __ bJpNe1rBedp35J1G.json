    {
      "parameters": {
        "jsCode": "// Extract text from Claude response\nconst claudeResponse = $input.first().json;\nconst emailBody = claudeResponse.content?.[0]?.text || 'Weekly update from IntraWeb Technologies';\nconst contact = $('Get Contact Email').item.json;\nconst context = $('Check Last Activity and Build Context').item.json;\n\nreturn [{\n  json: {\n    emailBody,\n    toEmail: contact.properties?.email || '',\n    firstName: contact.properties?.firstname || 'there',\n    lastName: contact.properties?.lastname || '',\n    company: contact.properties?.company || context.dealName,\n    dealName: context.dealName,\n    dealId: context.dealId\n  }\n}];\n"
      },

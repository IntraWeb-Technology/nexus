        "url": "=https://api.hubapi.com/crm/v3/objects/tasks?properties=hs_task_subject,hs_task_status,hs_task_type,hs_task_body,hubspot_owner_id,hs_due_date&filterGroups[0][filters][0][propertyName]=associations.deal&filterGroups[0][filters][0][operator]=EQ&filterGroups[0][filters][0][value]={{$('Split Client Deals').item.json.id}}&filterGroups[0][filters][1][propertyName]=hs_task_status&filterGroups[0][filters][1][operator]=NEQ&filterGroups[0][filters][1][value]=COMPLETED&limit=20",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.HUBSPOT_API_KEY}}"
            }

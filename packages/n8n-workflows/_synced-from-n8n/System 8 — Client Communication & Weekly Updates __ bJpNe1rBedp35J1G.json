      "id": "48c4029f-76ee-4be6-8eb1-98a75ffe846a",
      "name": "Get Open Tasks for Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -656,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// Check last activity date and build context for Claude\nconst deal = $('Split Client Deals').item.json;\nconst notesResponse = $('Get Deal Notes Past 7 Days').item.json;\nconst tasksResponse = $('Get Open Tasks for Deal').item.json;\n\nconst now = new Date();\nconst sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\n// Parse notes\nconst noteIds = (notesResponse.results || []).map(r => r.id);\nconst lastModified = deal.properties?.hs_lastmodifieddate\n  ? new Date(deal.properties.hs_lastmodifieddate)\n  : null;\n\nconst daysSinceActivity = lastModified\n  ? Math.floor((now - lastModified) / (1000 * 60 * 60 * 24))\n  : 99;\n\n// Parse open tasks\nconst openTasks = (tasksResponse.results || []).map(t => ({\n  subject: t.properties?.hs_task_subject || '',\n  status: t.properties?.hs_task_status || '',\n  dueDate: t.properties?.hs_due_date || '',\n  body: t.properties?.hs_task_body || ''\n}));\n\nconst openTasksSummary = openTasks.length > 0\n  ? openTasks.map(t => `- ${t.subject} (Due: ${t.dueDate || 'No date'})`).join('\\n')\n  : 'No open tasks';\n\nreturn [{\n  json: {\n    dealId: deal.id,\n    dealName: deal.properties?.dealname || 'Unknown Client',\n    dealStage: deal.properties?.dealstage || '',\n    closeDate: deal.properties?.closedate || '',\n    daysSinceActivity,\n    hasNoRecentActivity: daysSinceActivity >= 7,\n    openTasksSummary,\n    openTaskCount: openTasks.length,\n    noteCount: noteIds.length,\n    lastModified: lastModified ? lastModified.toISOString() : 'Unknown'\n  }\n}];\n"
      },

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 200,\n  \"system\": \"You are a command parser for the IntraWeb Command Center. Parse the user's message and return JSON identifying which command it is and any parameters. Commands: leads_this_week, pipeline_status, overdue_invoices, client_health, post_approved (param: row_number as integer), send_followup (param: contact_name as string), whats_due, revenue_this_month, regenerate_manual, unknown. Return only valid JSON: {\\\"command\\\": string, \\\"params\\\": object}. No other text.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{$json.normalized_text}}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "5f18c947-4548-4855-8a61-5dbd5e2271f3",
      "name": "Claude: Parse Command",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -688,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content[0].text;\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  try {\n    parsed = JSON.parse(match[0]);\n  } catch (e2) {\n    parsed = { command: 'unknown', params: {} };\n  }\n}\nconst upstream = $('Code: Normalize Command').first().json;\nreturn [{\n  json: {\n    command: parsed.command || 'unknown',\n    params: parsed.params || {},\n    raw_text: upstream.raw_text,\n    user_name: upstream.user_name,\n    user_id: upstream.user_id,\n    timestamp: upstream.timestamp\n  }\n}];"
      },

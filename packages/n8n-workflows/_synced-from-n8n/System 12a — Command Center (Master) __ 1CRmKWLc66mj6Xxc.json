    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst rawText = body?.message?.text || body?.text || '';\nconst user = body?.message?.sender?.displayName || body?.user?.displayName || 'Unknown User';\nconst userId = body?.message?.sender?.email || body?.user?.email || '';\nconst normalized = rawText.toLowerCase().trim().replace(/\\s+/g, ' ');\nreturn [{\n  json: {\n    raw_text: rawText,\n    normalized_text: normalized,\n    user_name: user,\n    user_id: userId,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "1948ca30-4fba-4d52-a787-b06391b427f5",
      "name": "Code: Normalize Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -896,
        208
      ]

    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{$vars.TWILIO_ACCOUNT_SID}}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "={{$('Merge Contact + Deal').item.json.phone}}"
            },
            {
              "name": "From",
              "value": "={{$vars.TWILIO_FROM}}"
            },
            {
              "name": "Body",
              "value": "=Hi {{$('Merge Contact + Deal').item.json.firstname}}, just checking in on the quote we sent over for your HVAC service. Any questions? We're happy to walk through it. — Apex Comfort ({{$vars.COMPANY_PHONE}})"
            }
          ]
        },
        "options": {}
      },

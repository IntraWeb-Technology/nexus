          "value": {
            "Timestamp": "={{new Date().toISOString()}}",
            "Workflow Name": "05-Quote-Followup",
            "Event Type": "DEAL_MOVED_TO_STALE",
            "Contact Name": "={{$('Merge Contact + Deal').item.json.firstname}}",
            "Phone": "={{$('Merge Contact + Deal').item.json.phone}}",
            "Email": "={{$('Merge Contact + Deal').item.json.email}}",
            "Deal ID": "={{$('Parse Deal Data').item.json.dealId}}",
            "Contact ID": "={{$('Parse Deal Data').item.json.contactId}}",
            "Status": "SUCCESS",
            "Notes": "No response to quote after 96hr — moved to Stale",
            "Workflow Run ID": "={{$execution.id}}",
            "Deal Stage": "Stale",
            "Amount": "={{$('Merge Contact + Deal').item.json.amount}}"
          }
        },
        "options": {}
      },

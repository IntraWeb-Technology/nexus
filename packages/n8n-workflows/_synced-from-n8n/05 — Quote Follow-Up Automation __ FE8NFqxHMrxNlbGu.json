      "typeVersion": 2,
      "position": [
        720,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{$vars.FROM_NAME}} <{{$vars.FROM_EMAIL}}>\",\n  \"to\": [\"{{ $('Merge Contact + Deal').item.json.email }}\"],\n  \"subject\": \"Your Apex Comfort quote — still available this week\",\n  \"html\": \"<p>Hi {{ $('Merge Contact + Deal').item.json.firstname }},</p><p>We sent you a quote a few days ago for your HVAC service and wanted to follow up one more time.</p><p>Our pricing is valid through this week, and we have scheduling availability if you're ready to move forward.</p><p><strong>Your quote summary:</strong><br>Service: {{ $('Merge Contact + Deal').item.json.dealName }}<br>Amount: ${{ $('Merge Contact + Deal').item.json.amount }}</p><p>Just hit reply or call us at {{$vars.COMPANY_PHONE}} — we'd love to get you on the schedule.</p><p>— The Apex Comfort Team</p>\"\n}",
        "options": {}
      },
      "id": "e1efaec9-49e5-4860-b532-207c0aaf6af1",
      "name": "96hr — Email Follow-Up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/deals/{{$('Parse Deal Data').item.json.dealId}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"dealstage\": \"{{$vars.HUBSPOT_STAGE_STALE}}\",\n    \"stale_date\": \"{{new Date().toISOString()}}\",\n    \"quote_followup_status\": \"completed\"\n  }\n}",
        "options": {}
      },
      "id": "bdd8262c-f2b2-497d-88a5-ce21c137e02a",
      "name": "Move Deal to Stale",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,

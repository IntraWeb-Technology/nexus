  "name": "05 — Quote Follow-Up Automation",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "deal-stage-change",
        "options": {}
      },
      "id": "9340cd30-c4e1-42d2-b3cd-1c98839de581",
      "name": "Deal Stage Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1920,
        208
      ],
      "webhookId": "wh-05-deal-stage",
      "notes": "Configure HubSpot Workflow: When deal stage changes to 'Quote Sent', send POST to this webhook URL with deal and contact data."
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// HubSpot sends deal properties via workflow webhook\nconst dealId = body.objectId || body.deal_id || body.hs_object_id || '';\nconst dealStage = body.properties?.dealstage?.value || body.dealstage || '';\nconst dealName = body.properties?.dealname?.value || body.dealname || '';\nconst amount = body.properties?.amount?.value || body.amount || '';\nconst invoiceNumber = body.properties?.invoice_number?.value || body.invoice_number || '';\n\n// Contact may be embedded or we need to fetch it\nconst contactId = body.associations?.contacts?.results?.[0]?.id || \n                   body.contact_id || '';\nconst contactName = body.contact_name || body.properties?.contact_firstname?.value || '';\nconst contactEmail = body.contact_email || '';\nlet contactPhone = body.contact_phone || body.properties?.contact_phone?.value || '';\n\nif (contactPhone && !contactPhone.startsWith('+')) {\n  contactPhone = '+1' + contactPhone.replace(/\\D/g, '');\n}\n\n// Only process Quote Sent stage\nif (!dealStage.includes('quote')) {\n  return [{ json: { skip: true, reason: 'Not a Quote Sent trigger', dealId, dealStage } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    dealId,\n    dealStage,\n    dealName,\n    amount,\n    invoiceNumber,\n    contactId,\n    contactName,\n    contactEmail,\n    contactPhone,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "160c4067-4a54-47c9-bf62-4408d4a3958f",
      "name": "Parse Deal Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1680,
        208
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-skip-05",
              "leftValue": "={{$json.skip}}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c0e9b280-d3fb-40e9-96a0-71b8590a797c",
      "name": "Is Quote Sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1440,
        208
      ]
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{$json.contactId}}?properties=firstname,lastname,phone_e164,email,phone",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "f981e28a-b90e-40d7-829b-1e66491e7c80",
      "name": "Get Contact Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1200,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const contact = $input.first().json;\nconst dealData = $('Parse Deal Data').item.json;\n\nconst firstname = contact.properties?.firstname?.value || dealData.contactName || 'there';\nconst phone = contact.properties?.phone_e164?.value || contact.properties?.phone?.value || dealData.contactPhone;\nconst email = contact.properties?.email?.value || dealData.contactEmail;\n\nreturn [{\n  json: {\n    ...dealData,\n    firstname,\n    phone,\n    email\n  }\n}];"
      },
      "id": "65d2e2d9-de20-465a-9210-32a07f3ac9af",
      "name": "Merge Contact + Deal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        112
      ]
    },
    {
      "parameters": {
        "amount": 48
      },
      "id": "16c4e5f3-813f-4f02-9dad-e402e69f3fd3",
      "name": "Wait 48 Hours",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        -720,
        112
      ],
      "webhookId": "eebe7f31-1420-47c1-9c03-143eafa01a62"
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/deals/{{$('Parse Deal Data').item.json.dealId}}?properties=dealstage,dealname,amount",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "ee5142d9-0754-4c4e-9d13-0d4e49ab118a",

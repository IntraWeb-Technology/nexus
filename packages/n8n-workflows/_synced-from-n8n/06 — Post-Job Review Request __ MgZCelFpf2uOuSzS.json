        },
        "sheetName": {
          "__rl": true,
          "value": "Event Log",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{$('Build Review SMS').item.json.sentAt}}",
            "Workflow Name": "06-Post-Job-Review",
            "Event Type": "REVIEW_REQUEST_SENT",
            "Contact Name": "={{$('Build Review SMS').item.json.firstname}}",
            "Phone": "={{$('Build Review SMS').item.json.phone}}",
            "Email": "",
            "Deal ID": "={{$('Parse Job Complete Data').item.json.dealId}}",
            "Contact ID": "={{$('Parse Job Complete Data').item.json.contactId}}",
            "Status": "SUCCESS",
            "Notes": "=Google review SMS sent 1hr after Job Complete. Deal: {{$('Parse Job Complete Data').item.json.dealName}}",
            "Workflow Run ID": "={{$execution.id}}",
            "Deal Stage": "Job Complete",
            "Amount": ""
          }
        },
        "options": {}
      },

            "firstname",
            "lastname",
            "email",
            "phone",
            "company",
            "website",
            "message",
            "lead_score",
            "lead_tier",
            "scoring_breakdown",
            "jobtitle",
            "decision_maker"
          ]
        }
      },
      "credentials": {
        "hubspotAppToken": {
          "id": "ZDFqX6DMxufgJufI",
          "name": "HubSpot account"
        }
      }
    },
    {
      "id": "8eb99ec9-146e-4146-8d46-5942e0ed539c",
      "name": "Generate Proposal via Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"claude-sonnet-4-20250514\", \"max_tokens\": 1500, \"system\": \"You are a senior proposal writer for IntraWeb Technologies LLC, a New Jersey-based AI automation and operations firm. Positioning: 95% of AI pilots fail to deliver ROI. We fix that. IntraWeb delivers Operations as a Service for SMBs with 10-150 employees. Two tracks: AI Transformation (strategy, long-term partnerships) and AI Engineering (hands-on technical execution). Pricing: Automation Starter $2,500 ($1k upfront plus $1,500 and $300/mo at go-live). Automation Growth $4,000 ($2k down plus $2k and $450/mo). SaaS Website Launch $6k-$10k. Premium $32k-$65k. Hourly $150-$175/hr. Tone: precise, operator-minded. No em dashes. No fluff. Problems feel systemic not the clients fault. Change feels rational and safe. Sections: Executive Summary, The Problem We Are Addressing, Proposed Approach, Scope of Work, Investment, Timeline, Why IntraWeb, Next Steps. Under 700 words. Use [CONFIRM WITH CLIENT] for gaps.\", \"messages\": [{ \"role\": \"user\", \"content\": \"Generate a client proposal.\\n\\nDEAL\\nName: \" + $(\"Get Deal\").item.json.properties.dealname + \"\\nAmount: \" + ($(\"Get Deal\").item.json.properties.amount ? \"$\" + $(\"Get Deal\").item.json.properties.amount : \"TBD\") + \"\\nStage: \" + ($(\"Get Deal\").item.json.properties.dealstage || \"Unknown\") + \"\\nType: \" + ($(\"Get Deal\").item.json.properties.dealtype || \"Unknown\") + \"\\nDescription: \" + ($(\"Get Deal\").item.json.properties.description || \"None\") + \"\\nPriority: \" + ($(\"Get Deal\").item.json.properties.hs_priority || \"Not set\") + \"\\nNext Step: \" + ($(\"Get Deal\").item.json.properties.hs_next_step || \"Not set\") + \"\\nClose Date: \" + ($(\"Get Deal\").item.json.properties.closedate || \"Not set\") + \"\\n\\nCLIENT\\nName: \" + $json.properties.firstname + \" \" + $json.properties.lastname + \"\\nCompany: \" + $json.properties.company + \"\\nEmail: \" + $json.properties.email + \"\\nPhone: \" + $json.properties.phone + \"\\nWebsite: \" + ($json.properties.website || \"Not provided\") + \"\\nJob Title: \" + ($json.properties.jobtitle || \"Not provided\") + \"\\nDecision Maker: \" + ($json.properties.decision_maker || \"Unknown\") + \"\\nLead Tier: \" + ($json.properties.lead_tier || \"Unknown\") + \"\\nIntake Message: \" + ($json.properties.message || \"No intake message.\") + \"\\nScore Breakdown: \" + ($json.properties.scoring_breakdown || \"N/A\") }] } }}"
      },
      "credentials": {}
    },
    {
      "id": "74d4ec51-44c4-49a2-a324-3e53645c9d89",
      "name": "Proposal Ready",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1340,

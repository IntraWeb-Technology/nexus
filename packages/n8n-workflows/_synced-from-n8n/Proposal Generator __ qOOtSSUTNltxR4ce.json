        "fields": {
          "values": [
            {
              "name": "proposal",
              "type": "stringValue",
              "value": "={{ $json.content[0].text }}"
            },
            {
              "name": "deal",
              "type": "stringValue",
              "value": "={{ $(\"Get Deal\").item.json.properties.dealname }}"
            },
            {
              "name": "client",
              "type": "stringValue",
              "value": "={{ $(\"Get Associated Contact\").item.json.properties.firstname + \" \" + $(\"Get Associated Contact\").item.json.properties.lastname }}"
            },
            {
              "name": "amount",
              "type": "stringValue",
              "value": "={{ $(\"Get Deal\").item.json.properties.amount ? \"$\" + $(\"Get Deal\").item.json.properties.amount : \"TBD\" }}"
            },
            {
              "name": "generated_at",
              "type": "stringValue",
              "value": "={{ $now.toISO() }}"
            }
          ]
        }
      }
    }

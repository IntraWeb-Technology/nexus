    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"system\": \"{{$json.ai_system_prompt}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{$json.ai_user_prompt}}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "b81393e4-b7c9-4f84-8324-0eaa7d50b06a",
      "name": "Claude: Generate Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -1104,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Execute Workflow Trigger').first().json;\nconst response = $input.first().json;\n\nlet subject = lead.default_subject || `Quick question about ${lead.company_name || 'your business'}`;\nlet bodyHtml = lead.default_body_html || `<p>Hi ${lead.first_name || 'there'},</p><p>Wanted to follow up.</p><p>- John, IntraWeb Technologies</p>`;\n\ntry {\n  const content = response.content?.[0]?.text;\n  if (content) {\n    const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    const parsed = JSON.parse(cleaned);\n    subject = parsed.subject || subject;\n    bodyHtml = parsed.body_html || bodyHtml;\n  }\n} catch (error) {\n  // Keep defaults if Claude returns malformed JSON.\n}\n\nreturn [{\n  json: {\n    ...lead,\n    email_subject: subject,\n    email_body_html: bodyHtml,\n    touch_count: lead.touch_number || lead.touch_count || 0\n  }\n}];"
      },
      "id": "87441182-8dca-427e-ae0a-aa103352dbbb",
      "name": "Code: Parse Email Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

      "id": "492411b5-badc-46ea-89e3-d6810e124675",
      "name": "New Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -720,
        144
      ],
      "webhookId": "wh-03-lead-followup",
      "notes": "Triggered by HubSpot Workflow when a new contact is created with lifecyclestage=lead. Configure in HubSpot: Workflows → New Contact → Trigger Action → Send Webhook POST to this URL with contact properties."
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// HubSpot webhook sends contact properties\nconst contactId = body.objectId || body.contact_id || body.hs_object_id || '';\nconst firstname = body.properties?.firstname?.value || body.firstname || 'there';\nconst lastname = body.properties?.lastname?.value || body.lastname || '';\nconst phone = body.properties?.phone_e164?.value || body.properties?.phone?.value || body.phone_e164 || body.phone || '';\nconst email = body.properties?.email?.value || body.email || '';\nconst replyStatus = body.properties?.reply_status?.value || body.reply_status || 'no_reply';\nconst sequenceStatus = body.properties?.followup_sequence_status?.value || 'active';\n\n// Don't start sequence if already stopped or if they've already replied\nif (replyStatus === 'replied' || replyStatus === 'booked' || sequenceStatus !== 'active') {\n  return [{ json: { skip: true, reason: 'Already replied or sequence not active', contactId } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    contactId,\n    firstname,\n    lastname,\n    fullName: `${firstname} ${lastname}`.trim(),\n    phone,\n    email,\n    replyStatus,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },

        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{$vars.FROM_NAME}} <{{$vars.FROM_EMAIL}}>\",\n  \"to\": [\"{{ $('Extract Contact Data').item.json.email }}\"],\n  \"subject\": \"We got your request — Apex Comfort HVAC\",\n  \"html\": \"<p>Hi {{ $('Extract Contact Data').item.json.firstname }},</p><p>Thanks for reaching out to Apex Comfort! We've received your service request and one of our team members will give you a call within 2 hours.</p><p>In the meantime, if you have any questions or need to reach us sooner, just reply to this email or call us at {{$vars.COMPANY_PHONE}}.</p><p>We appreciate your business!</p><p>— The Apex Comfort Team</p>\"\n}",
        "options": {}

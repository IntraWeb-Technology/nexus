        "url": "={{$vars.CHAT_WEBHOOK}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"📞 *New AI Voice Lead*\\n\\n*Name:* {{ $('Merge Contact ID').item.json.fullName }}\\n*Phone:* {{ $('Merge Contact ID').item.json.phone }}\\n*Service:* {{ $('Merge Contact ID').item.json.serviceType }}\\n*Urgency:* {{ $('Merge Contact ID').item.json.urgency }}\\n*Address:* {{ $('Merge Contact ID').item.json.serviceAddress }}\\n*Lead Score:* {{ $('Merge Contact ID').item.json.leadScore }}/10\\n*Callback within:* {{ $('Merge Contact ID').item.json.callbackWindow }}\\n*Summary:* {{ $('Merge Contact ID').item.json.summary }}\"\n}",
        "options": {}
      },

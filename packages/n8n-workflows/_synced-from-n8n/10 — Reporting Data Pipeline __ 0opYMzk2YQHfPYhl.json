    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/deals/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"pipeline\",\n          \"operator\": \"EQ\",\n          \"value\": \"{{$vars.HUBSPOT_PIPELINE_ID}}\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"dealname\", \"dealstage\", \"amount\", \"createdate\", \"closedate\", \"hs_object_id\", \"intake_source\", \"job_type\"],\n  \"limit\": 200,\n  \"sorts\": [{\"propertyName\": \"createdate\", \"direction\": \"DESCENDING\"}]\n}",
        "options": {}
      },
      "id": "70b1dd07-09a8-4e32-bb3a-c74e8bb52aa4",
      "name": "Get All Pipeline Deals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"createdate\",\n          \"operator\": \"GTE\",\n          \"value\": \"{{ new Date(new Date().getFullYear(), new Date().getMonth(), 1).getTime() }}\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"firstname\", \"lastname\", \"createdate\", \"lifecyclestage\", \"lead_source_detail\", \"reply_status\"],\n  \"limit\": 200,\n  \"sorts\": [{\"propertyName\": \"createdate\", \"direction\": \"DESCENDING\"}]\n}",
        "options": {}
      },
      "id": "adcb2d15-0932-4eb9-9c5e-b1977153b814",
      "name": "Get Contacts This Month",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate pipeline metrics from HubSpot data\nconst dealsResult = $('Get All Pipeline Deals').item.json;\nconst contactsResult = $('Get Contacts This Month').item.json;\n\nconst deals = dealsResult.results || [];\nconst contacts = contactsResult.results || [];\n\nconst now = new Date();\nconst monthStart = new Date(now.getFullYear(), now.getMonth(), 1);\n\n// Deal stage mappings\nconst PAID_STAGE = $vars.HUBSPOT_STAGE_PAID || 'paid';\nconst QUOTE_STAGE = $vars.HUBSPOT_STAGE_QUOTE_SENT || 'quote_sent';\nconst SCHEDULED_STAGE = $vars.HUBSPOT_STAGE_SCHEDULED || 'scheduled';\nconst COMPLETE_STAGE = $vars.HUBSPOT_STAGE_JOB_COMPLETE || 'job_complete';\nconst INVOICE_STAGE = $vars.HUBSPOT_STAGE_INVOICE_SENT || 'invoice_sent';\nconst STALE_STAGE = $vars.HUBSPOT_STAGE_STALE || 'stale';\n\n// Filter to this month's deals\nconst monthDeals = deals.filter(d => {\n  const created = new Date(d.properties?.createdate?.value || 0);\n  return created >= monthStart;\n});\n\n// Count by stage\nconst countByStage = (stageId) => monthDeals.filter(d => d.properties?.dealstage?.value === stageId).length;\nconst amountByStage = (stageId) => monthDeals\n  .filter(d => d.properties?.dealstage?.value === stageId)\n  .reduce((sum, d) => sum + parseFloat(d.properties?.amount?.value || 0), 0);\n\n// Pipeline metrics\nconst leadsThisMonth = contacts.length;\nconst quotesThisMonth = countByStage(QUOTE_STAGE) + countByStage(SCHEDULED_STAGE) + countByStage(COMPLETE_STAGE) + countByStage(INVOICE_STAGE) + countByStage(PAID_STAGE);\nconst jobsBooked = countByStage(SCHEDULED_STAGE) + countByStage(COMPLETE_STAGE) + countByStage(INVOICE_STAGE) + countByStage(PAID_STAGE);\nconst jobsCompleted = countByStage(COMPLETE_STAGE) + countByStage(INVOICE_STAGE) + countByStage(PAID_STAGE);\nconst paidThisMonth = countByStage(PAID_STAGE);\nconst revenueCollected = amountByStage(PAID_STAGE);\nconst revenuePipeline = deals\n  .filter(d => ![PAID_STAGE, STALE_STAGE].includes(d.properties?.dealstage?.value))\n  .reduce((sum, d) => sum + parseFloat(d.properties?.amount?.value || 0), 0);\n\n// Overdue invoices (Invoice Sent stage)\nconst overdueInvoices = deals.filter(d => d.properties?.dealstage?.value === INVOICE_STAGE);\nconst overdueCount = overdueInvoices.length;\nconst overdueTotal = overdueInvoices.reduce((sum, d) => sum + parseFloat(d.properties?.amount?.value || 0), 0);\n\n// Conversion rate\nconst conversionRate = quotesThisMonth > 0 ? ((jobsBooked / quotesThisMonth) * 100).toFixed(1) + '%' : '0%';\n\nconst timestamp = now.toISOString();\nconst monthLabel = now.toLocaleString('en-US', { month: 'long', year: 'numeric' });\n\nreturn [{\n  json: {\n    timestamp,\n    monthLabel,\n    leadsThisMonth,\n    quotesThisMonth,\n    jobsBooked,\n    jobsCompleted,\n    paidThisMonth,\n    conversionRate,\n    revenueCollected: revenueCollected.toFixed(2),\n    revenuePipeline: revenuePipeline.toFixed(2),\n    overdueCount,\n    overdueTotal: overdueTotal.toFixed(2),\n    dealsByStage: {\n      quote_sent: countByStage(QUOTE_STAGE),\n      scheduled: countByStage(SCHEDULED_STAGE),\n      job_complete: jobsCompleted,\n      invoice_sent: countByStage(INVOICE_STAGE),\n      paid: paidThisMonth,\n      stale: countByStage(STALE_STAGE)\n    }\n  }\n}];"
      },
      "id": "3425c2a9-7dfa-40fe-8116-89dfda7b0568",
      "name": "Aggregate Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,

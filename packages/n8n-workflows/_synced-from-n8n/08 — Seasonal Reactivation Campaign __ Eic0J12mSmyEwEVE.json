      "id": "c20b4e8a-65d1-4496-be69-93259e4ceac4",
      "name": "Reply Webhook (YES Response)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        304
      ],
      "webhookId": "wh-08-campaign-reply",
      "notes": "Configure in Twilio: When an inbound SMS contains 'YES', forward to this webhook. Or use a separate Twilio Studio flow to capture replies and POST here."
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// Twilio inbound SMS\nconst from = body.From || body.from || '';\nconst messageBody = (body.Body || body.body || '').toUpperCase().trim();\n\nlet phone = from.trim();\nif (phone && !phone.startsWith('+')) {\n  phone = '+1' + phone.replace(/\\D/g, '');\n}\n\nconst isYes = messageBody === 'YES' || messageBody === 'Y' || messageBody.startsWith('YES');\n\nreturn [{\n  json: {\n    phone,\n    messageBody,\n    isYes,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "14097f5a-c376-4e27-8867-367726b7e8fe",
      "name": "Parse Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-is-yes",
              "leftValue": "={{$json.isYes}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "40454b2f-230e-40fc-a38f-6eaed3e89849",

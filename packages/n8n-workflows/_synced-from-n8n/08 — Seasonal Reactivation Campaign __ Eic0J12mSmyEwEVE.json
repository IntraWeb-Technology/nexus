      "id": "7c192506-3b63-4c9e-86aa-13fea4e2a388",
      "name": "Schedule Trigger (Mar 1 & Oct 1)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Determine which season we're in\nconst now = new Date();\nconst month = now.getMonth() + 1; // 1-12\n\nconst isSpring = month <= 6;\nconst season = isSpring ? 'Spring' : 'Fall';\nconst serviceType = isSpring ? 'AC' : 'heating';\nconst campaignName = `${season} ${now.getFullYear()} ${serviceType.toUpperCase()} Check`;\n\n// Calculate cutoff date — contacts whose last_job_date is more than 6 months ago\nconst sixMonthsAgo = new Date();\nsixMonthsAgo.setMonth(sixMonthsAgo.getMonth() - 6);\nconst cutoffTimestamp = sixMonthsAgo.getTime();\n\nreturn [{\n  json: {\n    season,\n    serviceType,\n    campaignName,\n    cutoffTimestamp,\n    cutoffDate: sixMonthsAgo.toISOString().split('T')[0],\n    month,\n    isSpring,\n    runDate: now.toISOString()\n  }\n}];"
      },
      "id": "a4878f6d-020c-427e-a489-0aad59b842b8",
      "name": "Set Season Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"lifecyclestage\",\n          \"operator\": \"EQ\",\n          \"value\": \"customer\"\n        },\n        {\n          \"propertyName\": \"last_job_date\",\n          \"operator\": \"LT\",\n          \"value\": \"{{ $json.cutoffTimestamp }}\"\n        },\n        {\n          \"propertyName\": \"phone_e164\",\n          \"operator\": \"HAS_PROPERTY\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"firstname\", \"phone_e164\", \"phone\", \"last_job_date\", \"spring_campaign_sent\", \"fall_campaign_sent\"],\n  \"limit\": 100,\n  \"after\": 0\n}",
        "options": {}
      },
      "id": "56f4c535-93c5-4918-aedb-f0d9a30a7bd1",
      "name": "Get Eligible Customers — Page 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Filter out contacts who already received this season's campaign\nconst searchResult = $input.first().json;\nconst seasonCtx = $('Set Season Context').item.json;\n\nconst contacts = searchResult.results || [];\nconst campaignField = seasonCtx.isSpring ? 'spring_campaign_sent' : 'fall_campaign_sent';\nconst currentYear = new Date().getFullYear().toString();\n\nconst eligible = contacts.filter(contact => {\n  const campaignSent = contact.properties?.[campaignField]?.value;\n  // Skip if already sent this year\n  if (campaignSent && campaignSent.includes(currentYear)) return false;\n  // Skip if no phone\n  const phone = contact.properties?.phone_e164?.value || contact.properties?.phone?.value;\n  if (!phone) return false;\n  return true;\n});\n\nreturn eligible.map(contact => ({\n  json: {\n    contactId: contact.id,\n    firstname: contact.properties?.firstname?.value || 'there',\n    phone: contact.properties?.phone_e164?.value || contact.properties?.phone?.value,\n    lastJobDate: contact.properties?.last_job_date?.value,\n    season: seasonCtx.season,\n    serviceType: seasonCtx.serviceType,\n    campaignName: seasonCtx.campaignName,\n    campaignField\n  }\n}));"
      },
      "id": "759360cb-93f4-40c2-9c89-97ed47000b3b",
      "name": "Filter Already-Messaged",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },

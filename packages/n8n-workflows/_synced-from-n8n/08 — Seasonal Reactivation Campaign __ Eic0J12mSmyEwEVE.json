        "jsonBody": "={\n  \"properties\": {\n    \"dealname\": \"{{ $json.season }} Campaign — {{ $json.firstname }}\",\n    \"pipeline\": \"{{$vars.HUBSPOT_PIPELINE_ID}}\",\n    \"dealstage\": \"{{$vars.HUBSPOT_STAGE_NEW_LEAD}}\",\n    \"job_type\": \"tune_up\",\n    \"intake_source\": \"seasonal\",\n    \"job_notes\": \"Responded YES to {{ $json.season }} reactivation campaign\"\n  },\n  \"associations\": [\n    {\n      \"to\": { \"id\": \"{{ $json.contactId }}\" },\n      \"types\": [\n        {\n          \"associationCategory\": \"HUBSPOT_DEFINED\",\n          \"associationTypeId\": 3\n        }\n      ]\n    }\n  ]\n}",

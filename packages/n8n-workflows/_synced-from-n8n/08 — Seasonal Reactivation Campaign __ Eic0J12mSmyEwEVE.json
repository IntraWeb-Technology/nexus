        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"phone_e164\",\n          \"operator\": \"EQ\",\n          \"value\": \"{{ $json.phone }}\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"firstname\", \"lastname\", \"phone_e164\", \"email\", \"hs_object_id\"],\n  \"limit\": 1\n}",
        "options": {}
      },
      "id": "fe1cf654-e109-4d9a-b1c9-3578ecfb7792",
      "name": "Find Contact by Phone",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const searchResult = $input.first().json;\nconst replyData = $('Parse Reply').item.json;\n\nconst contact = searchResult.results?.[0];\nconst contactId = contact?.id || 'unknown';\nconst firstname = contact?.properties?.firstname?.value || 'Customer';\nconst email = contact?.properties?.email?.value || '';\n\n// Determine season based on current month\nconst month = new Date().getMonth() + 1;\nconst season = month <= 6 ? 'Spring' : 'Fall';\nconst serviceType = month <= 6 ? 'AC tune-up/check' : 'heating check';\n\nreturn [{\n  json: {\n    contactId,\n    firstname,\n    email,\n    phone: replyData.phone,\n    season,\n    serviceType,\n    timestamp: replyData.timestamp\n  }\n}];"
      },

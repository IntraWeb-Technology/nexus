  "name": "01 — Missed Call Text-Back",
  "description": null,
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "missed-call-textback",
        "options": {}
      },
      "id": "b447b216-3d68-43ad-8538-42935111da1f",
      "name": "Twilio Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1200,
        208
      ],
      "webhookId": "wh-01-missed-call"
    },
    {
      "parameters": {
        "jsCode": "// Parse Twilio status callback payload\nconst body = $input.first().json.body || $input.first().json;\n\n// Twilio sends form-encoded data, n8n parses it into json\nconst callStatus = body.CallStatus || '';\nconst callerPhone = body.From || body.Caller || '';\nconst calledPhone = body.To || body.Called || '';\nconst callSid = body.CallSid || '';\nconst direction = body.Direction || 'inbound';\n\n// Only process missed/no-answer/busy/failed calls\nconst missedStatuses = ['no-answer', 'busy', 'failed', 'canceled'];\nconst isMissed = missedStatuses.includes(callStatus.toLowerCase());\n\n// Normalize phone to E.164 if it isn't already\nlet phone = callerPhone.trim();\nif (phone && !phone.startsWith('+')) {\n  phone = '+1' + phone.replace(/\\D/g, '');\n}\n\n// Validate — skip anonymous/blocked calls\nconst isValidPhone = phone && phone.length >= 10 && !phone.includes('anonymous') && !phone.includes('blocked');\n\nreturn [{\n  json: {\n    isMissed,\n    callStatus,\n    callerPhone: phone,\n    calledPhone,\n    callSid,\n    direction,\n    isValidPhone,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "a85cfd76-d237-4b1e-b932-23f64ce6c7f8",
      "name": "Parse Twilio Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        208
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-missed-1",
              "leftValue": "={{$json.isMissed}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "cond-missed-2",
              "leftValue": "={{$json.isValidPhone}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2c75445d-91b8-4009-9be1-bee1f71e871d",
      "name": "Is Missed Call?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -720,
        208
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    {\n      \"filters\": [\n        {\n          \"propertyName\": \"phone_e164\",\n          \"operator\": \"EQ\",\n          \"value\": \"{{ $json.callerPhone }}\"\n        }\n      ]\n    }\n  ],\n  \"properties\": [\"firstname\", \"lastname\", \"phone\", \"phone_e164\", \"email\", \"hs_object_id\"],\n  \"limit\": 1\n}",
        "options": {}
      },
      "id": "12cdb044-6862-43c6-acfb-864954b4aed8",
      "name": "Search HubSpot Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -480,
        112
      ]
    },
    {

        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{$json.results[0].id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"hs_lead_status\": \"NEW\",\n    \"lead_source_detail\": \"missed_call\"\n  }\n}",
        "options": {}
      },
      "id": "4bd1bccf-5afa-4bb9-84c2-e00fee298dc5",
      "name": "Update Existing Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Merge contact ID from either create or update branch\nconst item = $input.first().json;\nconst contactId = item.id || (item.results && item.results[0] ? item.results[0].id : null);\nconst callerPhone = $('Parse Twilio Payload').item.json.callerPhone;\nconst companyPhone = $vars.COMPANY_PHONE || $vars.TWILIO_FROM;\n\nreturn [{\n  json: {\n    contactId,\n    callerPhone,\n    companyPhone,\n    smsBody: `Hey, we just missed your call! What can we help with? Reply here or call us back at ${companyPhone}. — Apex Comfort`,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },

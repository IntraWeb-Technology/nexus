      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude's JSON response and prepare Sheets row\nconst response = $input.first().json;\nconst story = $('Split Stories Into Batches').item.json;\n\nlet parsedPost;\ntry {\n  const content = response.content[0].text;\n  // Extract JSON from response (handle markdown code blocks if present)\n  const jsonMatch = content.match(/```json\\n?([\\s\\S]*?)\\n?```/) || content.match(/(\\{[\\s\\S]*\\})/);\n  const jsonStr = jsonMatch ? jsonMatch[1] : content;\n  parsedPost = JSON.parse(jsonStr);\n} catch (e) {\n  parsedPost = {\n    hook: story.title.substring(0, 120),\n    full_post: response.content?.[0]?.text || 'Post generation failed',\n    hashtags: ['#AI', '#Automation', '#Business'],\n    suggested_link: story.link,\n    news_source: story.source\n  };\n}\n\nconst now = new Date().toISOString();\nconst hashtagStr = Array.isArray(parsedPost.hashtags) ? parsedPost.hashtags.join(' ') : parsedPost.hashtags;\n\nreturn [{\n  json: {\n    dateGenerated: now,\n    newsHook: parsedPost.hook || '',\n    fullPost: parsedPost.full_post || '',\n    hashtags: hashtagStr || '',\n    suggestedLink: parsedPost.suggested_link || story.link,\n    status: 'Pending Review',\n    scheduledTime: '',\n    postNotes: '',\n    newsSource: parsedPost.news_source || story.source,\n    originalTitle: story.title\n  }\n}];\n"
      },

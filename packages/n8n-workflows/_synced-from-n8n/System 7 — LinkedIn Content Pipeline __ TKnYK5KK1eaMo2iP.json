    {
      "parameters": {
        "jsCode": "// Parse all RSS XML feeds and extract top 5 AI/business automation stories from past 24 hours\nconst items = $input.all();\nconst now = new Date();\nconst oneDayAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000);\n\nconst aiKeywords = [\n  'ai', 'artificial intelligence', 'machine learning', 'automation', 'llm',\n  'gpt', 'claude', 'gemini', 'openai', 'anthropic', 'chatbot', 'neural',\n  'robotics', 'saas', 'workflow', 'productivity', 'software', 'startup',\n  'business', 'revenue', 'growth', 'enterprise', 'agent', 'generative'\n];\n\nconst parseRSSItem = (xmlText, sourceName) => {\n  const results = [];\n  if (!xmlText) return results;\n\n  // Extract <item> or <entry> blocks\n  const itemRegex = /<(?:item|entry)[^>]*>([\\s\\S]*?)<\\/(?:item|entry)>/gi;\n  let match;\n\n  while ((match = itemRegex.exec(xmlText)) !== null) {\n    const block = match[1];\n\n    const getTag = (tag) => {\n      const m = block.match(new RegExp(`<${tag}[^>]*><!\\\\[CDATA\\\\[([\\\\s\\\\S]*?)\\\\]\\\\]><\\/${tag}>`, 'i'))\n        || block.match(new RegExp(`<${tag}[^>]*>([\\\\s\\\\S]*?)<\\/${tag}>`, 'i'));\n      return m ? m[1].trim().replace(/<[^>]+>/g, '') : '';\n    };\n\n    const title = getTag('title');\n    const description = getTag('description') || getTag('summary') || getTag('content');\n    const link = getTag('link') || (block.match(/<link[^>]*href=[\"']([^\"']+)[\"']/i) || [])[1] || '';\n    const pubDate = getTag('pubDate') || getTag('published') || getTag('updated') || '';\n\n    let publishedAt;\n    try {\n      publishedAt = pubDate ? new Date(pubDate) : null;\n    } catch (e) {\n      publishedAt = null;\n    }\n\n    const isRecent = publishedAt ? publishedAt >= oneDayAgo : true;\n    const text = (title + ' ' + description).toLowerCase();\n    const isRelevant = aiKeywords.some(kw => text.includes(kw));\n\n    if (title && isRecent && isRelevant) {\n      results.push({\n        title,\n        description: description.substring(0, 400),\n        link,\n        publishedAt: publishedAt ? publishedAt.toISOString() : now.toISOString(),\n        source: sourceName\n      });\n    }\n  }\n  return results;\n};\n\nlet allStories = [];\nconst sources = ['TechCrunch', 'VentureBeat', 'The Verge', 'Hacker News'];\n\nitems.forEach((item, idx) => {\n  const xmlText = item.json.data || item.json.body || '';\n  const source = sources[idx] || 'Unknown';\n  const parsed = parseRSSItem(xmlText, source);\n  allStories = allStories.concat(parsed);\n});\n\n// Sort by published date desc, take top 5\nallStories.sort((a, b) => new Date(b.publishedAt) - new Date(a.publishedAt));\nconst top5 = allStories.slice(0, 5);\n\nif (top5.length === 0) {\n  // Fallback: return at least 1 placeholder so workflow doesn't break\n  return [{\n    json: {\n      title: 'AI automation continues to reshape business operations',\n      description: 'Companies are increasingly adopting AI-driven workflows to reduce manual work and accelerate growth.',\n      link: 'https://techcrunch.com',\n      publishedAt: now.toISOString(),\n      source: 'TechCrunch'\n    }\n  }];\n}\n\nreturn top5.map(story => ({ json: story }));\n"
      },

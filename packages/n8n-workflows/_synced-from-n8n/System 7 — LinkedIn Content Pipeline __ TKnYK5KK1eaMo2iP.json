    {
      "parameters": {
        "jsCode": "// Find rows where Status = 'Approved' and Scheduled Time is due\nconst sheetData = $input.first().json;\nconst rows = sheetData.values || [];\nif (rows.length < 2) return [];\n\nconst headers = rows[0];\n// Expected columns: Date Generated, News Hook, Full Post, Hashtags, Suggested Link, Status, Scheduled Time, Post Notes, News Source\nconst dateIdx = 0;\nconst hookIdx = 1;\nconst postIdx = 2;\nconst hashtagsIdx = 3;\nconst linkIdx = 4;\nconst statusIdx = 5;\nconst scheduledIdx = 6;\nconst notesIdx = 7;\n\nconst now = new Date();\nconst duePosts = [];\n\nrows.slice(1).forEach((row, rowIndex) => {\n  const status = row[statusIdx] || '';\n  const scheduledTime = row[scheduledIdx] || '';\n\n  if (status.toLowerCase() === 'approved') {\n    let isDue = false;\n    if (scheduledTime) {\n      try {\n        const scheduledDate = new Date(scheduledTime);\n        isDue = scheduledDate <= now;\n      } catch (e) {\n        isDue = true; // If can't parse, treat as due\n      }\n    } else {\n      isDue = true; // No scheduled time = post now\n    }\n\n    if (isDue) {\n      duePosts.push({\n        rowIndex: rowIndex + 2, // 1-indexed with header offset\n        dateGenerated: row[dateIdx] || '',\n        hook: row[hookIdx] || '',\n        fullPost: row[postIdx] || '',\n        hashtags: row[hashtagsIdx] || '',\n        suggestedLink: row[linkIdx] || '',\n        scheduledTime: scheduledTime,\n        notes: row[notesIdx] || ''\n      });\n    }\n  }\n});\n\nif (duePosts.length === 0) return [];\nreturn duePosts.map(p => ({ json: p }));\n"
      },

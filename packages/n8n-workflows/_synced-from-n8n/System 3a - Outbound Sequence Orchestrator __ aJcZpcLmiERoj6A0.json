    {
      "parameters": {
        "content": "## README\nOwns the System 3 webhook, wait cadence, and stop/continue branching.\n\nImport child workflows first, then set every blank `Execute Workflow` `workflowId` in this file before activating.\n\nWebhook path: `start-outbound-sequence`.",
        "height": 220,
        "width": 420,
        "color": 5
      },
      "id": "640de953-df82-48d4-897b-49751611b14b",
      "name": "README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "start-outbound-sequence",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "7c660754-6832-4d4f-a2cb-70f6b40cea40",
      "name": "Webhook Start Sequence",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        224,
        288
      ],
      "webhookId": "start-outbound-sequence"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst contactId = body.contact_id || '';\nconst contactName = body.contact_name || body.firstname || 'there';\nconst companyName = body.company_name || body.company || '';\nconst phoneRaw = body.phone || '';\nconst email = body.email || '';\nconst industry = body.industry || 'your industry';\n\nlet phone = phoneRaw.replace(/[^0-9]/g, '');\nif (phone.length === 10) {\n  phone = '+1' + phone;\n} else if (phone.length === 11 && phone.startsWith('1')) {\n  phone = '+' + phone;\n} else {\n  phone = phoneRaw;\n}\n\nconst firstName = contactName.split(' ')[0] || contactName;\n\nreturn [{\n  json: {\n    contact_id: contactId,\n    contact_name: contactName,\n    first_name: firstName,\n    company_name: companyName,\n    phone,\n    phone_raw: phoneRaw,\n    email,\n    industry,\n    sequence_start: new Date().toISOString(),\n    sequence_stop: false,\n    touch_count: 0\n  }\n}];"
      },
      "id": "bd0f4e0f-82fb-447d-83b6-c845c716286b",
      "name": "Set Sequence Variables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nreturn [{\n  json: {\n    ...lead,\n    touch_number: 1,\n    touch_count: 1,\n    ai_system_prompt: 'You are writing a cold outreach email for John at IntraWeb Technologies, NJ-based AI automation consulting. Voice: direct, specific, no fluff, no em dashes. Reference the recipient\\'s specific industry. One clear pain point. Soft CTA to reply or book. Output valid JSON with fields: subject (string) and body_html (string with HTML email markup).',\n    ai_user_prompt: `Write a personalized intro cold outreach email to ${lead.first_name} at ${lead.company_name}, a business in the ${lead.industry} industry in NJ. Address one specific operational pain point common in ${lead.industry}. CTA is to reply or book a 15-min call. Sign off as John from IntraWeb Technologies. Output JSON only with subject and body_html fields.`,\n    default_subject: `Quick question about ${lead.company_name}`,\n    default_body_html: `<p>Hi ${lead.first_name},</p><p>Following up on some ideas for ${lead.company_name}.</p><p>- John, IntraWeb Technologies</p>`,\n    hubspot_note_intro: 'Touch 1 (Day 0) - Intro email sent via Resend.',\n    should_log_to_sheet: true,\n    sheet_log_status: 'Success',\n    sheet_log_summary: `Touch 1 email sent to ${lead.contact_name} at ${lead.company_name}`,\n    sheet_log_context: 'Sequence start'\n  }\n}];"
      },

    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nreturn [{\n  json: {\n    ...lead,\n    touch_number: 3,\n    touch_count: 3,\n    ai_system_prompt: 'You are writing a follow-up cold outreach email for John at IntraWeb Technologies, NJ-based AI automation consulting. Voice: direct, specific, no fluff, no em dashes. This is touch 3 in a sequence. Reference specific automation examples for the recipient\\'s industry. Show what\\'s possible with AI automation. CTA to book a 15-min call. Output valid JSON with fields: subject (string) and body_html (string with HTML email markup).',\n    ai_user_prompt: `Write a follow-up email (touch 3, day 5) to ${lead.first_name} at ${lead.company_name} in the ${lead.industry} industry. Include 2-3 specific real-world automation examples relevant to ${lead.industry} businesses. Show what IntraWeb could build for them. CTA: book a 15-min call. Output JSON only with subject and body_html fields.`,\n    default_subject: `What AI automation looks like for ${lead.industry} businesses`,\n    default_body_html: `<p>Hi ${lead.first_name},</p><p>Wanted to share some examples of what automation could look like for ${lead.company_name}.</p><p>- John, IntraWeb Technologies</p>`,\n    hubspot_note_intro: 'Touch 3 (Day 5) - Automation examples email sent.',\n    should_log_to_sheet: false,\n    sheet_log_status: 'Success',\n    sheet_log_summary: '',\n    sheet_log_context: ''\n  }\n}];"

    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nreturn [{\n  json: {\n    ...lead,\n    touch_number: 5,\n    touch_count: 5,\n    ai_system_prompt: 'You are writing a closing-the-loop final email in a 5-touch cold outreach sequence for John at IntraWeb Technologies, NJ-based AI automation consulting. Voice: direct, no fluff, no em dashes. This is the last email in the sequence. Be respectful of their time. Offer a free 20-minute operations audit with zero obligation. Make it easy to say yes. Output valid JSON with fields: subject (string) and body_html (string with HTML email markup).',\n    ai_user_prompt: `Write the final closing-the-loop email (touch 5, day 14) to ${lead.first_name} at ${lead.company_name} in the ${lead.industry} industry. Acknowledge this is the last email. Offer a free 20-minute operations audit. Make the offer feel low-risk and specific. CTA: reply yes or click the calendar link. Sign off as John from IntraWeb. Output JSON only with subject and body_html fields.`,\n    default_subject: `Closing the loop - free 20-min ops audit for ${lead.company_name}`,\n    default_body_html: `<p>Hi ${lead.first_name},</p><p>Last email from me. Wanted to offer a free 20-minute operations audit for ${lead.company_name} - no pitch, just value.</p><p>- John, IntraWeb Technologies</p>`,\n    hubspot_note_intro: 'Touch 5 (Day 14) - Final closing email sent. Sequence complete.',\n    should_log_to_sheet: false,\n    sheet_log_status: 'Success',\n    sheet_log_summary: '',\n    sheet_log_context: ''\n  }\n}];"

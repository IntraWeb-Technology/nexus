    {
      "parameters": {
        "jsCode": "// Store the parent folder ID and prepare subfolder creation list\nconst parentFolderId = $input.item.json.id;\nconst client = $('Prepare Onboarding Variables').item.json;\n\nconst subfolders = [\n  'Credentials',\n  'Deliverables',\n  'Meeting Notes',\n  'Contracts',\n  'Onboarding Docs'\n];\n\nreturn subfolders.map(name => ({\n  json: {\n    subfolder_name: name,\n    parent_folder_id: parentFolderId,\n    company_name: client.company_name,\n    client_name: client.client_name,\n    email: client.email,\n    phone: client.phone,\n    tier: client.tier,\n    deal_value: client.deal_value,\n    deal_id: client.deal_id,\n    first_name: client.first_name,\n    onboarding_start: client.onboarding_start\n  }\n}));"
      },

    {
      "parameters": {
        "jsCode": "// After all subfolders created, prepare HubSpot tasks\nconst client = $('Prepare Onboarding Variables').item.json;\nconst parentFolderId = $('Create Google Drive Client Folder').item.json.id;\nconst folderUrl = 'https://drive.google.com/drive/folders/' + parentFolderId;\n\nconst tasks = [\n  { title: 'Credentials received', note: 'Confirm client credentials intake form has been completed and credentials stored in Drive /Credentials folder.' },\n  { title: 'Kickoff scheduled', note: 'Confirm kickoff call has been booked via Calendly.' },\n  { title: 'Kickoff complete', note: 'Kickoff call completed. Notes filed in Drive /Meeting Notes.' },\n  { title: 'First workflow delivered', note: 'First automation workflow built, tested, and delivered to client.' },\n  { title: 'Client trained', note: 'Client training session completed. Recording saved in Drive /Deliverables.' },\n  { title: 'Docs delivered', note: 'All documentation and SOPs delivered to client Drive /Onboarding Docs.' }\n];\n\nconst dueDate = new Date();\ndueDate.setDate(dueDate.getDate() + 7);\nconst dueDateMs = dueDate.getTime();\n\nreturn tasks.map(task => ({\n  json: {\n    task_title: task.title,\n    task_note: task.note,\n    due_date_ms: dueDateMs,\n    deal_id: client.deal_id,\n    company_name: client.company_name,\n    client_name: client.client_name,\n    email: client.email,\n    phone: client.phone,\n    tier: client.tier,\n    deal_value: client.deal_value,\n    first_name: client.first_name,\n    drive_folder_url: folderUrl,\n    parent_folder_id: parentFolderId,\n    onboarding_start: client.onboarding_start\n  }\n}));"
      },

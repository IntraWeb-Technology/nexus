        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"John <john@intrawebtech.com>\",\n  \"to\": [\"{{ $('Prepare Onboarding Variables').item.json.email }}\"],\n  \"subject\": \"Action required: IntraWeb credentials intake form\",\n  \"html\": \"<h2>Hi {{ $('Prepare Onboarding Variables').item.json.first_name }},</h2><p>To get started, we need a few credentials and account accesses. This allows us to begin building your automations right away.</p><p><strong>Please complete the form below within 48 hours so we can stay on schedule:</strong></p><p><a href='{{ $env.CREDENTIALS_INTAKE_FORM_URL }}' style='background:#0066cc;color:white;padding:12px 24px;text-decoration:none;border-radius:4px;display:inline-block;'>Complete Credentials Intake Form</a></p><p>The form takes about 10 minutes and covers: CRM access, email platform, any existing tools/software, and anything else relevant to your workflows.</p><p>If you have any questions about what we need or why, just reply to this email.</p><p>John<br>IntraWeb Technologies</p>\"\n}",
        "options": {}

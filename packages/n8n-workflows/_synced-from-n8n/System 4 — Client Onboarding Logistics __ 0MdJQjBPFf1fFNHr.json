    {
      "parameters": {
        "jsCode": "// Merge webhook payload with HubSpot deal data\nconst webhookBody = $('Webhook Deal Closed Won').item.json.body || $('Webhook Deal Closed Won').item.json;\nconst dealData = $input.item.json;\n\nconst deal_id = webhookBody.deal_id || '';\nconst client_name = webhookBody.client_name || '';\nconst company_name = webhookBody.company_name || '';\nconst email = webhookBody.email || '';\nconst phone_raw = webhookBody.phone || '';\nconst tier = webhookBody.tier || 'Starter';\nconst deal_value = webhookBody.deal_value || dealData.properties?.amount || '0';\n\n// Normalize phone\nlet phone = phone_raw.replace(/[^0-9]/g, '');\nif (phone.length === 10) phone = '+1' + phone;\nelse if (phone.length === 11 && phone.startsWith('1')) phone = '+' + phone;\nelse phone = phone_raw;\n\n// Extract first name\nconst first_name = client_name.split(' ')[0] || client_name;\n\nreturn [{\n  json: {\n    deal_id,\n    client_name,\n    first_name,\n    company_name,\n    email,\n    phone,\n    phone_raw,\n    tier,\n    deal_value,\n    onboarding_start: new Date().toISOString(),\n    hubspot_deal_properties: dealData.properties || {}\n  }\n}];"
      },

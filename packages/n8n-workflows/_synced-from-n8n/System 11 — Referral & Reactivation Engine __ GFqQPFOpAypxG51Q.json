            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 600,\n  \"system\": \"Write a referral request email from John at IntraWeb Technologies. Tone: personal, genuine, not templated. Reference the specific project completed. Ask if they know any other business owners who struggle with operations or want to automate. Mention IntraWeb gives a $500 credit for referrals that close. Under 200 words. No em dashes. Return JSON with keys: subject (string) and html_body (string with HTML formatting).\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Client name: {{$json.body.client_name}}\\nCompany: {{$json.body.company_name}}\\nProject summary: {{$json.body.project_summary}}\\n\\nWrite the referral request email and return as JSON with subject and html_body keys.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "ac3904fe-021d-46bb-80c4-cbeaf613f5fb",
      "name": "Claude: Generate Referral Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1760,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const rawContent = $input.first().json.content[0].text;\nlet parsed;\ntry {\n  parsed = JSON.parse(rawContent);\n} catch (e) {\n  const match = rawContent.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match[0]);\n}\nconst body = $('Webhook: Project Complete').first().json.body;\nreturn [{\n  json: {\n    subject: parsed.subject,\n    html_body: parsed.html_body,\n    client_name: body.client_name,\n    company_name: body.company_name,\n    email: body.email,\n    phone: body.phone,\n    deal_id: body.deal_id,\n    project_summary: body.project_summary\n  }\n}];"
      },
      "id": "d199a689-29e5-44e4-97bc-c7281021fdc5",

    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst results = response.results || [];\nconst contactData = $('Parse Reactivation Email Content').first().json;\nif (results.length === 0) {\n  return [{ json: { replied: false, ...contactData } }];\n}\nconst props = results[0].properties;\nconst lastEmailDate = props.hs_last_email_date ? new Date(props.hs_last_email_date) : null;\nconst fourDaysAgo = new Date(Date.now() - 4 * 24 * 60 * 60 * 1000);\nconst replied = lastEmailDate && lastEmailDate > fourDaysAgo;\nreturn [{ json: { replied, ...contactData } }];"
      },

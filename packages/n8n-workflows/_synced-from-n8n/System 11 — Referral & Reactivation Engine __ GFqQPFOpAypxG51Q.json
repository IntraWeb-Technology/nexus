    {
      "parameters": {
        "jsCode": "const contact = $input.first().json;\nconst results = contact.results || [];\nconst referralData = $('Parse Referral Email Content').first().json;\nif (results.length === 0) {\n  return [{\n    json: {\n      replied: false,\n      client_name: referralData.client_name,\n      phone: referralData.phone,\n      email: referralData.email,\n      deal_id: referralData.deal_id\n    }\n  }];\n}\nconst props = results[0].properties;\nconst lastEmailDate = props.hs_last_email_date ? new Date(props.hs_last_email_date) : null;\nconst sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\nconst replied = lastEmailDate && lastEmailDate > sevenDaysAgo;\nreturn [{\n  json: {\n    replied,\n    client_name: referralData.client_name,\n    phone: referralData.phone,\n    email: referralData.email,\n    deal_id: referralData.deal_id\n  }\n}];"
      },

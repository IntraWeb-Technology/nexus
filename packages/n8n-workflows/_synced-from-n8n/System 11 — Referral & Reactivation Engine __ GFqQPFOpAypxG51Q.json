        "jsonBody": "={\n  \"properties\": {\n    \"hs_note_body\": \"Referral request email sent to {{$json.client_name}} at {{$json.company_name}} on {{$now.format('MMMM d, yyyy')}}. Subject: {{$json.subject}}\",\n    \"hs_timestamp\": \"{{$now.toISO()}}\"\n  },\n  \"associations\": [\n    {\n      \"to\": {\"id\": \"{{$json.deal_id}}\"},\n      \"types\": [{\"associationCategory\": \"HUBSPOT_DEFINED\", \"associationTypeId\": 214}]\n    }\n  ]\n}",

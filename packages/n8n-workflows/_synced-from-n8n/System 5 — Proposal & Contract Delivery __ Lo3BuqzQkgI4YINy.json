        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 800,\n  \"system\": \"You are writing a follow-up email for John at IntraWeb Technologies after sending a consulting proposal. Voice: direct, no fluff, no em dashes. The proposal has been out for 4 days with no response. Be professional, address any possible hesitation, and make it easy to say yes or ask questions. Output valid JSON with fields: subject (string) and body_html (string with HTML markup).\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a 96-hour follow-up email to {{ $('Prepare Approved Proposal Data').item.json.first_name }} at {{ $('Prepare Approved Proposal Data').item.json.company_name }}. The proposal for ${{ $('Prepare Approved Proposal Data').item.json.deal_value }}/month has been out for 4 days. Address common hesitations (timing, scope, ROI). Offer to jump on a quick call to answer any questions. Keep it under 150 words. Output JSON only with subject and body_html fields.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "e85f7937-8eb6-4123-a5c2-fbe4337e0bfb",
      "name": "Claude 96hr Follow Up Email Gen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        3312,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const claudeResponse = $input.item.json;\nconst approvedData = $('Prepare Approved Proposal Data').item.json;\n\nlet subject = 'Following up on your IntraWeb proposal';\nlet body_html = '<p>Hi ' + approvedData.first_name + ',</p><p>Following up on the proposal for ' + approvedData.company_name + '. Happy to hop on a quick call to address any questions. — John, IntraWeb</p>';\n\ntry {\n  const content = claudeResponse.content && claudeResponse.content[0] && claudeResponse.content[0].text;\n  if (content) {\n    const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    const parsed = JSON.parse(cleaned);\n    subject = parsed.subject || subject;\n    body_html = parsed.body_html || body_html;\n  }\n} catch(e) {}\n\nreturn [{\n  json: {\n    ...approvedData,\n    followup_subject: subject,\n    followup_body_html: body_html\n  }\n}];"
      },

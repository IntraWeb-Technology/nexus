      "id": "3c3a264f-57ec-452e-b756-66841ce6256c",
      "name": "Get Full Deal and Contact HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Merge webhook payload with HubSpot deal data\nconst webhookBody = $('Webhook Deal Proposal Stage').item.json.body || $('Webhook Deal Proposal Stage').item.json;\nconst dealData = $input.item.json;\n\nconst deal_id = webhookBody.deal_id || '';\nconst company_name = webhookBody.company_name || dealData.properties?.dealname || '';\nconst industry = webhookBody.industry || '';\nconst pain_points = webhookBody.pain_points || '';\nconst deal_value = webhookBody.deal_value || dealData.properties?.amount || '0';\nconst tier = webhookBody.tier || 'Starter';\nconst contact_email = webhookBody.contact_email || '';\nconst contact_name = webhookBody.contact_name || '';\nconst contact_phone_raw = webhookBody.contact_phone || '';\n\n// Normalize phone\nlet contact_phone = contact_phone_raw.replace(/[^0-9]/g, '');\nif (contact_phone.length === 10) contact_phone = '+1' + contact_phone;\nelse if (contact_phone.length === 11 && contact_phone.startsWith('1')) contact_phone = '+' + contact_phone;\nelse contact_phone = contact_phone_raw;\n\nconst first_name = contact_name.split(' ')[0] || contact_name;\n\nreturn [{\n  json: {\n    deal_id,\n    company_name,\n    industry,\n    pain_points,\n    deal_value,\n    tier,\n    contact_email,\n    contact_name,\n    first_name,\n    contact_phone,\n    contact_phone_raw,\n    proposal_requested_at: new Date().toISOString(),\n    hubspot_deal: dealData.properties || {}\n  }\n}];"
      },
      "id": "a80af88f-601a-47b8-b0be-f50cadba19ee",
      "name": "Prepare Proposal Variables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 4000,\n  \"system\": \"You are writing a consulting proposal for IntraWeb Technologies LLC, a NJ-based AI automation firm. IntraWeb's positioning: we are the implementation layer for AI-enabled operations. We don't just advise — we build. Write in a direct, confident, builder tone. No corporate speak. No em dashes. Use real numbers and specific outcomes where possible. Output a complete HTML proposal document with inline CSS styling. The proposal must include these sections as H2 headings: Executive Summary, The Problem We're Solving, What We'll Build, Timeline, Investment, Why IntraWeb, Next Steps. Make it look professional and polished.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a full consulting proposal for the following engagement:\\n\\nClient Company: {{ $json.company_name }}\\nIndustry: {{ $json.industry }}\\nPain Points: {{ $json.pain_points }}\\nProposed Investment: ${{ $json.deal_value }}/month\\nService Tier: {{ $json.tier }}\\nContact Name: {{ $json.contact_name }}\\n\\nThe proposal should be specific to their industry, address their stated pain points directly, and outline what IntraWeb will build for them. Include realistic timelines and specific deliverables. The Investment section should present the ${{ $json.deal_value }}/month fee as a clear ROI play. Next Steps should be: sign agreement, complete credentials intake, schedule kickoff call. Output complete HTML with inline CSS only.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "1009b268-4beb-4e59-a619-443b6548e6bb",
      "name": "Claude Generate Proposal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract HTML from Claude response\nconst claudeResponse = $input.item.json;\nconst proposalData = $('Prepare Proposal Variables').item.json;\n\nlet proposalHtml = '';\n\ntry {\n  const content = claudeResponse.content && claudeResponse.content[0] && claudeResponse.content[0].text;\n  if (content) {\n    proposalHtml = content.trim();\n    // If Claude wrapped in markdown code blocks, strip them\n    if (proposalHtml.startsWith('```html')) {\n      proposalHtml = proposalHtml.replace(/^```html\\n?/, '').replace(/\\n?```$/, '').trim();\n    } else if (proposalHtml.startsWith('```')) {\n      proposalHtml = proposalHtml.replace(/^```\\n?/, '').replace(/\\n?```$/, '').trim();\n    }\n  }\n} catch(e) {\n  proposalHtml = '<html><body><h1>Proposal for ' + proposalData.company_name + '</h1><p>Proposal generation encountered an error. Please regenerate.</p></body></html>';\n}\n\nreturn [{\n  json: {\n    ...proposalData,\n    proposal_html: proposalHtml,\n    proposal_filename: 'IntraWeb-Proposal-' + proposalData.company_name.replace(/[^a-zA-Z0-9]/g, '-') + '-' + new Date().toISOString().split('T')[0] + '.pdf'\n  }\n}];"
      },
      "id": "9e5ec994-f372-4550-a964-53911fefdd7f",
      "name": "Extract Proposal HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PDF_SERVICE_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PDF_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"html\": \"{{ $json.proposal_html }}\",\n  \"filename\": \"{{ $json.proposal_filename }}\",\n  \"options\": {\n    \"format\": \"A4\",\n    \"margin\": {\n      \"top\": \"20mm\",\n      \"right\": \"15mm\",\n      \"bottom\": \"20mm\",\n      \"left\": \"15mm\"\n    },\n    \"printBackground\": true\n  }\n}",
        "options": {}
      },
      "id": "0e4360b9-96de-42b3-b13d-1df4fc7e2dca",
      "name": "Convert HTML to PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1104,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Handle PDF conversion result\n// The PDF service returns either a base64 string or a URL\nconst pdfResult = $input.item.json;\nconst proposalData = $('Extract Proposal HTML').item.json;\n\nlet pdfBase64 = '';\nlet pdfUrl = '';\n\nif (pdfResult.pdf_base64) {\n  pdfBase64 = pdfResult.pdf_base64;\n} else if (pdfResult.base64) {\n  pdfBase64 = pdfResult.base64;\n} else if (pdfResult.url) {\n  pdfUrl = pdfResult.url;\n} else if (pdfResult.data) {\n  pdfBase64 = pdfResult.data;\n}\n\nreturn [{\n  json: {\n    ...proposalData,\n    pdf_base64: pdfBase64,\n    pdf_download_url: pdfUrl,\n    pdf_ready: !!(pdfBase64 || pdfUrl)\n  }\n}];"
      },
      "id": "7f77bafe-d4cb-4d0c-82ac-76c3e8e18242",
      "name": "Process PDF Result",
      "type": "n8n-nodes-base.code",

      "id": "12adbe12-3f5f-4028-97cc-a795f473ca59",
      "name": "Set Drive File Shareable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build shareable Drive link\nconst driveUploadResult = $('Upload PDF to Google Drive').item.json;\nconst proposalData = $('Process PDF Result').item.json;\n\nconst fileId = driveUploadResult.id;\nconst driveLink = 'https://drive.google.com/file/d/' + fileId + '/view';\nconst downloadLink = 'https://drive.google.com/uc?export=download&id=' + fileId;\n\nreturn [{\n  json: {\n    ...proposalData,\n    drive_file_id: fileId,\n    drive_link: driveLink,\n    download_link: downloadLink\n  }\n}];"
      },

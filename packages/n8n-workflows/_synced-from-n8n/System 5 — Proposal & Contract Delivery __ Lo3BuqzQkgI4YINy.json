    {
      "parameters": {
        "jsCode": "// Extract approval payload (triggered when Status set to 'Approved' in Sheets)\nconst body = $input.item.json.body || $input.item.json;\n\nconst deal_id = body.deal_id || '';\nconst company_name = body.company_name || '';\nconst contact_name = body.contact_name || '';\nconst contact_email = body.contact_email || '';\nconst contact_phone = body.contact_phone || '';\nconst tier = body.tier || '';\nconst deal_value = body.deal_value || '';\nconst drive_link = body.drive_link || '';\nconst download_link = body.download_link || '';\nconst first_name = contact_name.split(' ')[0] || contact_name;\n\nreturn [{\n  json: {\n    deal_id,\n    company_name,\n    contact_name,\n    first_name,\n    contact_email,\n    contact_phone,\n    tier,\n    deal_value,\n    drive_link,\n    download_link,\n    approved_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "58be6d96-5d0c-4ee2-a510-3be9fa9bf3a1",
      "name": "Prepare Approved Proposal Data",
      "type": "n8n-nodes-base.code",

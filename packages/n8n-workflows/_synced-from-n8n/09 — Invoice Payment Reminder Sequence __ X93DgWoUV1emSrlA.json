      "position": [
        -1680,
        112
      ],
      "webhookId": "wh-09-invoice-sent",
      "notes": "Trigger: HubSpot Workflow when deal stage = 'Invoice Sent'. POST deal + contact + invoice data to this URL."
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst dealId = body.objectId || body.deal_id || body.hs_object_id || '';\nconst dealStage = body.properties?.dealstage?.value || body.dealstage || '';\nconst dealName = body.properties?.dealname?.value || body.dealname || '';\nconst invoiceNumber = body.properties?.invoice_number?.value || body.invoice_number || 'INV-001';\nconst invoiceAmount = body.properties?.invoice_amount?.value || body.invoice_amount || '0';\nconst paymentLink = body.properties?.payment_link?.value || body.payment_link || $vars.PAYMENT_PORTAL_URL || 'https://pay.apexcomfort.com';\n\nconst contactId = body.associations?.contacts?.results?.[0]?.id || body.contact_id || '';\nconst firstname = body.contact_firstname || body.contact_name?.split(' ')[0] || 'there';\nlet contactPhone = body.contact_phone || '';\nconst contactEmail = body.contact_email || '';\n\nif (contactPhone && !contactPhone.startsWith('+')) {\n  contactPhone = '+1' + contactPhone.replace(/\\D/g, '');\n}\n\nreturn [{\n  json: {\n    dealId,\n    dealStage,\n    dealName,\n    invoiceNumber,\n    invoiceAmount,\n    paymentLink,\n    contactId,\n    firstname,\n    contactPhone,\n    contactEmail,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "cf28ea78-9c4f-43cb-98c8-a1119e24b6ee",
      "name": "Parse Invoice Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1440,
        112
      ]
    },
    {
      "parameters": {
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{$json.contactId}}?properties=firstname,phone_e164,phone,email",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "27a7bbe9-d990-4447-8675-f0cfba99538f",
      "name": "Get Contact Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,

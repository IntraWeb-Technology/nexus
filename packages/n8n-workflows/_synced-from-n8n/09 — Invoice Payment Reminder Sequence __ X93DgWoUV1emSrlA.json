        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{$vars.FROM_NAME}} <{{$vars.FROM_EMAIL}}>\",\n  \"to\": [\"{{ $('Merge Invoice + Contact').item.json.email }}\"],\n  \"subject\": \"Invoice #{{ $('Merge Invoice + Contact').item.json.invoiceNumber }} — Payment Reminder\",\n  \"html\": \"<p>Hi {{ $('Merge Invoice + Contact').item.json.firstname }},</p><p>This is a friendly reminder that invoice #{{ $('Merge Invoice + Contact').item.json.invoiceNumber }} for <strong>${{ $('Merge Invoice + Contact').item.json.invoiceAmount }}</strong> is still outstanding.</p><p><strong>Invoice Details:</strong><br>Invoice: #{{ $('Merge Invoice + Contact').item.json.invoiceNumber }}<br>Amount Due: ${{ $('Merge Invoice + Contact').item.json.invoiceAmount }}<br>Service: {{ $('Merge Invoice + Contact').item.json.dealName }}</p><p><a href='{{ $('Merge Invoice + Contact').item.json.paymentLink }}' style='background:#2563eb;color:white;padding:12px 24px;border-radius:6px;text-decoration:none;display:inline-block;'>Pay Invoice Online</a></p><p>If you have any questions about this invoice, please call us at {{$vars.COMPANY_PHONE}} or reply to this email.</p><p>Thank you for your business!<br>— The Apex Comfort Team</p>\"\n}",

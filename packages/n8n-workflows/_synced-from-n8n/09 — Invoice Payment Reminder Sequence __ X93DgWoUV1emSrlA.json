        -1200,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const contact = $input.first().json;\nconst inv = $('Parse Invoice Data').item.json;\n\nconst firstname = contact.properties?.firstname?.value || inv.firstname || 'there';\nconst phone = contact.properties?.phone_e164?.value || contact.properties?.phone?.value || inv.contactPhone;\nconst email = contact.properties?.email?.value || inv.contactEmail;\n\nreturn [{\n  json: {\n    ...inv,\n    firstname,\n    phone,\n    email\n  }\n}];"
      },
      "id": "6615bd70-c658-432f-9d15-e9d6c0b9de4c",

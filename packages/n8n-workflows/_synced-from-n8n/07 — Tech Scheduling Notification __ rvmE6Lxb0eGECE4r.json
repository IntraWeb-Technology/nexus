              "value": "=🔧 NEW JOB SCHEDULED\\nCustomer: {{$json.customerName}}\\nAddress: {{$json.serviceAddress}}\\nDate/Time: {{$json.scheduledDateFormatted}}\\nJob Type: {{$json.jobType}}\\nNotes: {{$json.jobNotes}}\\nCustomer Phone: {{$json.customerPhone}}"
            }
          ]
        },
        "options": {}
      },
      "id": "f81bf94d-95c6-4e17-bf37-b53f80a2e455",
      "name": "SMS to Tech — New Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Calculate day-before 7AM for the reminder\nconst jobData = $input.first().json;\nconst scheduledDateObj = jobData.scheduledDateObj ? new Date(jobData.scheduledDateObj) : null;\n\nif (!scheduledDateObj || isNaN(scheduledDateObj)) {\n  // If no scheduled date, set reminder for 1 day from now at 7AM\n  const tomorrow = new Date();\n  tomorrow.setDate(tomorrow.getDate() + 1);\n  tomorrow.setHours(7, 0, 0, 0);\n  return [{ json: { ...jobData, reminderTime: tomorrow.toISOString(), hasScheduledDate: false } }];\n}\n\n// Day before at 7:00 AM ET\nconst dayBefore = new Date(scheduledDateObj);\ndayBefore.setDate(dayBefore.getDate() - 1);\ndayBefore.setHours(12, 0, 0, 0); // 7AM ET = 12:00 UTC (EST offset)\n\n// If day before is in the past, send immediately (skip wait)\nconst now = new Date();\nconst reminderTime = dayBefore > now ? dayBefore.toISOString() : new Date(now.getTime() + 60000).toISOString();\n\nreturn [{ json: { ...jobData, reminderTime, hasScheduledDate: true } }];"
      },
      "id": "53b0cb25-d901-4f9a-87b1-5a81ea610236",

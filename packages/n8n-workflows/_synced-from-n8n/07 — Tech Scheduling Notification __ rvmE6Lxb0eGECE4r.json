      "id": "e5e39e11-e257-48fa-a1c4-9ae7cc159dd7",
      "name": "Scheduled Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -720,
        112
      ],
      "webhookId": "wh-07-scheduled",
      "notes": "Trigger: HubSpot Workflow when deal stage = 'Scheduled'. POST deal + contact data to this URL."
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst dealId = body.objectId || body.deal_id || body.hs_object_id || '';\nconst dealStage = body.properties?.dealstage?.value || body.dealstage || '';\nconst dealName = body.properties?.dealname?.value || body.dealname || 'HVAC Job';\nconst scheduledDate = body.properties?.scheduled_date?.value || body.scheduled_date || '';\nconst serviceAddress = body.properties?.service_address?.value || body.service_address || 'Address not set';\nconst jobType = body.properties?.job_type?.value || body.job_type || 'Service';\nconst jobNotes = body.properties?.job_notes?.value || body.job_notes || 'None';\nlet techPhone = body.properties?.tech_phone?.value || body.tech_phone || '';\n\nconst contactId = body.associations?.contacts?.results?.[0]?.id || body.contact_id || '';\nconst customerName = body.contact_name || body.properties?.contact_firstname?.value || 'Customer';\nlet customerPhone = body.contact_phone || '';\n\n// Normalize phones\nif (techPhone && !techPhone.startsWith('+')) {\n  techPhone = '+1' + techPhone.replace(/\\D/g, '');\n}\nif (customerPhone && !customerPhone.startsWith('+')) {\n  customerPhone = '+1' + customerPhone.replace(/\\D/g, '');\n}\n\n// Fallback to env var if no tech phone on deal\nif (!techPhone) {\n  techPhone = $vars.TECH_PHONE || '';\n}\n\n// Parse scheduled date\nlet scheduledDateFormatted = 'TBD';\nlet scheduledDateObj = null;\nif (scheduledDate) {\n  scheduledDateObj = new Date(scheduledDate);\n  scheduledDateFormatted = scheduledDateObj.toLocaleString('en-US', {\n    weekday: 'short',\n    month: 'short',\n    day: 'numeric',\n    hour: 'numeric',\n    minute: '2-digit',\n    timeZone: 'America/New_York'\n  });\n}\n\nreturn [{\n  json: {\n    dealId,\n    dealStage,\n    dealName,\n    scheduledDate,\n    scheduledDateFormatted,\n    scheduledDateObj: scheduledDateObj ? scheduledDateObj.toISOString() : null,\n    serviceAddress,\n    jobType,\n    jobNotes,\n    techPhone,\n    contactId,\n    customerName,\n    customerPhone,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "12ae62c3-fe44-447f-8af2-380bba236d6a",
      "name": "Parse Schedule Data",

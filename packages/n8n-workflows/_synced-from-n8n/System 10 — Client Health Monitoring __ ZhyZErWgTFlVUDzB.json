    {
      "parameters": {
        "jsCode": "// Compile health score summary across all clients processed\nconst allItems = $input.all();\n\nlet totalClients = 0;\nlet criticalClients = 0;\nlet goodClients = 0;\nlet avgScore = 0;\nlet scoreSum = 0;\nconst criticalList = [];\n\nallItems.forEach(item => {\n  totalClients++;\n  const score = item.json.healthScore || item.json.finalHealthScore || 0;\n  scoreSum += score;\n\n  if (score < 4) {\n    criticalClients++;\n    criticalList.push(`${item.json.processedClient || item.json.dealName}: ${score}`);\n  } else {\n    goodClients++;\n  }\n});\n\navgScore = totalClients > 0 ? (scoreSum / totalClients).toFixed(1) : 0;\n\nreturn [{\n  json: {\n    totalClients,\n    criticalClients,\n    goodClients,\n    avgScore,\n    criticalList: criticalList.join(', ') || 'None',\n    summaryText: `📊 Client Health Report: ${totalClients} clients. Critical: ${criticalClients} | Good: ${goodClients} | Avg Score: ${avgScore}`\n  }\n}];\n"
      },
      "id": "f1b84def-6a29-4a50-9648-a5c5594a937d",
      "name": "Compile Health Score Summary",

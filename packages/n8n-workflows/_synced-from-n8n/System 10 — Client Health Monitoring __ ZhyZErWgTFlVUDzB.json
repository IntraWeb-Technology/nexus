    {
      "parameters": {
        "jsCode": "// Extract Claude email text and prep send data\nconst claudeResponse = $input.first().json;\nconst emailBody = claudeResponse.content?.[0]?.text || 'Hi, just checking in to see how things are going. Let me know if you need anything. - John';\nconst contact = $('Get Contact Details for Low Health').item.json;\nconst healthData = $('Calculate Health Score').item.json;\n\nreturn [{\n  json: {\n    emailBody,\n    toEmail: contact.properties?.email || '',\n    firstName: contact.properties?.firstname || 'there',\n    company: contact.properties?.company || healthData.dealName,\n    dealName: healthData.dealName,\n    dealId: healthData.dealId,\n    healthScore: healthData.finalHealthScore\n  }\n}];\n"

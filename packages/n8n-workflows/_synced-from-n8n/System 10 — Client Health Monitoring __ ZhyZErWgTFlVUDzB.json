    {
      "parameters": {
        "jsCode": "// Filter deals to only active client deals\nconst response = $input.first().json;\nconst deals = response.results || [];\n\nconst activeClientStages = [\n  'active_client', 'onboarding', 'in_progress', 'delivery',\n  'active', 'contracted', 'client', 'implementation', 'production'\n];\n\nconst activeDeals = deals.filter(deal => {\n  const stage = (deal.properties?.dealstage || '').toLowerCase();\n  return activeClientStages.some(s => stage.includes(s));\n}) || deals; // Fall back to all non-closed if no matches\n\nreturn activeDeals.map(d => ({ json: d }));\n"
      },

      "id": "63f8af0d-2339-4085-b28c-efe185792f9c",
      "name": "Get Invoice and Payment Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "// Calculate client health score\nconst deal = $('Split Active Clients').item.json;\nconst activitiesResponse = $('Get Deal Activities Last 30 Days').item.json;\nconst tasksResponse = $('Get Open Tasks for This Deal').item.json;\nconst invoiceResponse = $('Get Invoice and Payment Status').item.json;\n\nconst now = new Date();\nconst thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);\nconst thirtyDaysFromNow = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);\nconst sevenDaysFromNow = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);\n\nlet score = 5; // Start at baseline\n\n// 1. Days since last HubSpot activity\nconst lastModifiedStr = deal.properties?.hs_lastmodifieddate;\nconst lastModified = lastModifiedStr ? new Date(lastModifiedStr) : null;\nconst lastContactDays = lastModified\n  ? Math.floor((now - lastModified) / (1000 * 60 * 60 * 24))\n  : 30;\n\nif (lastContactDays < 7) {\n  score += 3;\n} else if (lastContactDays >= 7 && lastContactDays < 14) {\n  score += 1;\n} else if (lastContactDays >= 14) {\n  score -= 2;\n}\n\n// 2. Overdue tasks penalty\nconst openTasks = tasksResponse.results || [];\nconst overdueTasks = openTasks.filter(task => {\n  const dueDate = task.properties?.hs_due_date;\n  if (!dueDate) return false;\n  return new Date(dueDate) < now;\n});\nscore -= overdueTasks.length * 2;\n\n// 3. Overdue invoice check (Invoice Sent > 30 days)\nconst invoiceStage = (invoiceResponse.properties?.dealstage || '').toLowerCase();\nconst invoiceLastModified = invoiceResponse.properties?.hs_lastmodifieddate\n  ? new Date(invoiceResponse.properties.hs_lastmodifieddate)\n  : null;\n\nconst isInvoiceSent = invoiceStage.includes('invoice_sent') || invoiceStage.includes('invoicesent');\nconst isInvoiceOverdue = isInvoiceSent && invoiceLastModified && invoiceLastModified < thirtyDaysAgo;\n\nif (isInvoiceOverdue) {\n  score -= 3;\n}\n\n// 4. Upcoming milestone this week (close date within 7 days)\nconst closeDate = deal.properties?.closedate;\nif (closeDate) {\n  const closeDateObj = new Date(closeDate);\n  if (closeDateObj >= now && closeDateObj <= sevenDaysFromNow) {\n    score += 2;\n  }\n}\n\nconst dealName = deal.properties?.dealname || 'Unknown Client';\n\nreturn [{\n  json: {\n    dealId: deal.id,\n    dealName,\n    dealStage: deal.properties?.dealstage || '',\n    lastContactDays,\n    overdueTaskCount: overdueTasks.length,\n    openTaskCount: openTasks.length,\n    isInvoiceOverdue,\n    closeDate: closeDate || '',\n    finalHealthScore: score,\n    isLowHealth: score < 4,\n    lastModified: lastModified ? lastModified.toISOString() : 'Unknown',\n    calculatedAt: now.toISOString()\n  }\n}];\n"
      },

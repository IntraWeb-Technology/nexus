{
  "updatedAt": "2026-04-18T22:43:30.000Z",
  "createdAt": "2026-04-11T01:31:35.720Z",
  "id": "9qda1h0jNk7zlVs9",
  "name": "Proposal Generator",
  "description": "Takes a contact name or email, pulls HubSpot contact and associated deal data, generates a formatted client proposal via Claude.",
  "active": false,
  "isArchived": true,
  "nodes": [
    {
      "id": "1889e9b3-29c2-4d9e-97ba-1e63050948fd",
      "name": "Run Proposal Generator",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "id": "f96d0ac4-2284-4641-b17e-a5de2102ceea",
      "name": "Search HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "resource": "contact",
        "operation": "search",
        "authentication": "appToken",
        "returnAll": false,
        "limit": 1,
        "filterGroupsUi": {
          "filterGroupsValues": [
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "email|string",
                    "operator": "CONTAINS_TOKEN",
                    "value": "={{ $json.contactQuery }}"
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "properties": [
            "firstname",
            "lastname",
            "email",
            "phone",
            "company",
            "website",
            "message",
            "lead_score",
            "lead_tier",
            "scoring_breakdown",
            "jobtitle",
            "decision_maker",
            "hs_lead_status"
          ]
        }
      },
      "credentials": {
        "hubspotAppToken": {
          "id": "ZDFqX6DMxufgJufI",
          "name": "HubSpot account"
        }
      }
    },
    {
      "id": "14196dfb-df57-4800-9dd4-8ef1d98e846c",
      "name": "Search Associated Deal",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "position": [
        760,
        300
      ],
      "parameters": {
        "resource": "deal",
        "operation": "search",
        "authentication": "appToken",
        "returnAll": false,
        "limit": 1,
        "filterGroupsUi": {
          "filterGroupsValues": [
            {
              "filtersUi": {
                "filterValues": [
                  {
                    "propertyName": "associations.contact|string",
                    "operator": "EQ",
                    "value": "={{ $(\"Search HubSpot Contact\").item.json.id }}"
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "properties": [
            "dealname",
            "amount",
            "dealstage",
            "description",
            "hs_priority",
            "hs_next_step",
            "closedate"
          ]
        }
      },
      "credentials": {
        "hubspotAppToken": {
          "id": "ZDFqX6DMxufgJufI",
          "name": "HubSpot account"
        }
      }
    },
    {
      "id": "d0bb5fea-7eb3-46c7-965b-54c8a8aaa1c2",
      "name": "Generate Proposal",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-20250514"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Generate a professional client proposal for IntraWeb Technologies using this data:\n\nCLIENT\nName: {{ $(\"Search HubSpot Contact\").item.json.properties.firstname }} {{ $(\"Search HubSpot Contact\").item.json.properties.lastname }}\nCompany: {{ $(\"Search HubSpot Contact\").item.json.properties.company }}\nEmail: {{ $(\"Search HubSpot Contact\").item.json.properties.email }}\nPhone: {{ $(\"Search HubSpot Contact\").item.json.properties.phone }}\nWebsite: {{ $(\"Search HubSpot Contact\").item.json.properties.website || \"Not provided\" }}\nJob Title: {{ $(\"Search HubSpot Contact\").item.json.properties.jobtitle || \"Not provided\" }}\nDecision Maker: {{ $(\"Search HubSpot Contact\").item.json.properties.decision_maker || \"Unknown\" }}\nLead Tier: {{ $(\"Search HubSpot Contact\").item.json.properties.lead_tier || \"Unknown\" }}\nIntake Message: {{ $(\"Search HubSpot Contact\").item.json.properties.message || \"No intake message.\" }}\nScore Breakdown: {{ $(\"Search HubSpot Contact\").item.json.properties.scoring_breakdown || \"N/A\" }}\n\nDEAL\nDeal Name: {{ $json.properties.dealname || \"No deal found\" }}\nAmount: {{ $json.properties.amount ? \"$\" + $json.properties.amount : \"TBD\" }}\nStage: {{ $json.properties.dealstage || \"Early stage\" }}\nDescription: {{ $json.properties.description || \"None\" }}\nPriority: {{ $json.properties.hs_priority || \"Not set\" }}\nNext Step: {{ $json.properties.hs_next_step || \"Not set\" }}"
            }
          ]
        },
        "options": {
          "system": "You are a senior proposal writer for IntraWeb Technologies LLC, a New Jersey-based AI automation and operations firm. IntraWeb positioning: 95% of AI pilots fail to deliver ROI. We fix that. IntraWeb delivers Operations as a Service, helping SMBs with 10-150 employees restructure internal processes to adopt AI effectively. The firm differentiates from consultancies, agencies, and platform vendors.\n\nTwo service tracks:\n- AI Transformation: strategy-focused long-term partnerships with executives and operators\n- AI Engineering: hands-on technical execution for technical leadership\n\nPricing:\n- Automation Starter: $2,500 ($1k upfront, $1,500 + $300/mo at go-live)\n- Automation Growth: $4,000 ($2k down, $2k + $450/mo at go-live)\n- SaaS Website Launch: $6k-$10k. Premium: $32k-$65k\n- Hourly: $150-$175/hr\n\nTone rules: precise and operator-minded. No em dashes. No fluff. Make problems feel systemic not the clients fault. Make change feel rational and safe.\n\nProposal sections: Executive Summary, The Problem We Are Addressing, Proposed Approach, Scope of Work, Investment, Timeline, Why IntraWeb, Next Steps. Keep under 700 words. Use [CONFIRM WITH CLIENT] for missing data.",
          "maxTokens": 1500
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "HprVnCwfCT3ULYEp",
          "name": "Anthropic account"
        }
      }
    },
    {
      "id": "10198516-230b-4c3a-851b-5a4e37e88c43",
      "name": "Format Proposal Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1280,
        300
      ],
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "proposal",
              "type": "stringValue",
              "value": "={{ $json.content[0].text }}"
            },
            {
              "name": "client",
              "type": "stringValue",
              "value": "={{ $(\"Search HubSpot Contact\").item.json.properties.firstname }} {{ $(\"Search HubSpot Contact\").item.json.properties.lastname }}"
            },
            {
              "name": "company",
              "type": "stringValue",
              "value": "={{ $(\"Search HubSpot Contact\").item.json.properties.company }}"
            },
            {
              "name": "generated_at",
              "type": "stringValue",
              "value": "={{ $now.toISO() }}"
            }
          ]
        }
      }
    }
  ],

        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are writing a cold outreach email for John at IntraWeb Technologies, NJ-based AI automation consulting. Voice: direct, specific, no fluff, no em dashes. Reference the recipient's specific industry. One clear pain point. Soft CTA to reply or book. Output valid JSON with fields: subject (string) and body_html (string with HTML email markup).\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a personalized intro cold outreach email to {{ $('Set Sequence Variables').item.json.first_name }} at {{ $('Set Sequence Variables').item.json.company_name }}, a business in the {{ $('Set Sequence Variables').item.json.industry }} industry in NJ. Address one specific operational pain point common in {{ $('Set Sequence Variables').item.json.industry }}. CTA is to reply or book a 15-min call. Sign off as John from IntraWeb Technologies. Output JSON only with subject and body_html fields.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "79840e71-10ef-4a6d-b5df-8dfc9591f6a6",
      "name": "Claude Touch 1 Email Gen",
      "type": "n8n-nodes-base.httpRequest",

    {
      "parameters": {
        "jsCode": "// Parse Claude response and extract subject + HTML body\nconst claudeResponse = $input.item.json;\nconst lead = $('Set Sequence Variables').item.json;\n\nlet subject = 'Quick question about ' + lead.company_name;\nlet body_html = '<p>Hi ' + lead.first_name + ',</p><p>Following up on some ideas for ' + lead.company_name + '.</p><p>— John, IntraWeb Technologies</p>';\n\ntry {\n  const content = claudeResponse.content && claudeResponse.content[0] && claudeResponse.content[0].text;\n  if (content) {\n    // Strip markdown code blocks if present\n    const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    const parsed = JSON.parse(cleaned);\n    subject = parsed.subject || subject;\n    body_html = parsed.body_html || body_html;\n  }\n} catch(e) {\n  // Keep defaults if parsing fails\n}\n\nreturn [{\n  json: {\n    ...lead,\n    email_subject: subject,\n    email_body_html: body_html,\n    touch: 1\n  }\n}];"
      },

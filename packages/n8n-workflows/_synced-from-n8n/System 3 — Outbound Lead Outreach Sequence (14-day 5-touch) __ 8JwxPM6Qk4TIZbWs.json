    {
      "parameters": {
        "jsCode": "// Extract and normalize incoming payload\nconst body = $input.item.json.body || $input.item.json;\n\nconst contact_id = body.contact_id || '';\nconst contact_name = body.contact_name || body.firstname || 'there';\nconst company_name = body.company_name || body.company || '';\nconst phone_raw = body.phone || '';\nconst email = body.email || '';\nconst industry = body.industry || 'your industry';\n\n// Normalize phone to E.164\nlet phone = phone_raw.replace(/[^0-9]/g, '');\nif (phone.length === 10) {\n  phone = '+1' + phone;\n} else if (phone.length === 11 && phone.startsWith('1')) {\n  phone = '+' + phone;\n} else {\n  phone = phone_raw;\n}\n\n// Extract first name\nconst first_name = contact_name.split(' ')[0] || contact_name;\n\nreturn [{\n  json: {\n    contact_id,\n    contact_name,\n    first_name,\n    company_name,\n    phone,\n    phone_raw,\n    email,\n    industry,\n    sequence_start: new Date().toISOString(),\n    sequence_stop: false,\n    touch_count: 0\n  }\n}];"
      },

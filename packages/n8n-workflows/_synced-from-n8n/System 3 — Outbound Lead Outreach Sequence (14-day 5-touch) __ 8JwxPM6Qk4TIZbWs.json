      "parameters": {
        "jsCode": "const claudeResponse = $input.item.json;\nconst lead = $('Set Sequence Variables').item.json;\n\nlet subject = 'Closing the loop — free 20-min ops audit for ' + lead.company_name;\nlet body_html = '<p>Hi ' + lead.first_name + ',</p><p>Last email from me. Wanted to offer a free 20-minute operations audit for ' + lead.company_name + ' — no pitch, just value.</p><p>— John, IntraWeb Technologies</p>';\n\ntry {\n  const content = claudeResponse.content && claudeResponse.content[0] && claudeResponse.content[0].text;\n  if (content) {\n    const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    const parsed = JSON.parse(cleaned);\n    subject = parsed.subject || subject;\n    body_html = parsed.body_html || body_html;\n  }\n} catch(e) {}\n\nreturn [{\n  json: {\n    ...lead,\n    email_subject: subject,\n    email_body_html: body_html,\n    touch: 5\n  }\n}];"
      },

  "name": "SYS 03 — Portal — HubSpot invoice → add_invoice",
  "description": "POST JSON to webhook; forwards to client portal /api/webhook/n8n with action add_invoice. Needs Header Auth credential matching WEBHOOK_SECRET.",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "portal-add-invoice",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2347dfe5-14df-495b-b811-79fc7a29d4f0",
      "name": "Invoice to Portal Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        400
      ],
      "webhookId": "7b28f195-7985-4271-b25e-e0ce329812ce"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet b = item.body ?? item;\nif (typeof b === 'string') {\n  try { b = JSON.parse(b); } catch (e) {\n    throw new Error('Webhook body must be valid JSON');\n  }\n}\nconst dealId = b.hubspot_deal_id ?? b.deal_id;\nconst slug = b.project_slug;\nif (!dealId && !slug) { throw new Error('hubspot_deal_id or project_slug required'); }\nconst data = {\n  invoice_number: String(b.invoice_number ?? ''),\n  description: String(b.description ?? 'Invoice'),\n  amount_cents: Math.round(Number(b.amount_cents ?? b.amountCents ?? 0)),\n  status: b.status || 'pending',\n};\nconst allowed = ['paid', 'pending', 'overdue', 'void'];\nif (allowed.indexOf(data.status) === -1) data.status = 'pending';\nif (b.sku) data.sku = String(b.sku);\nif (b.due_date) data.due_date = String(b.due_date);\nconst base = { action: 'add_invoice', data };\nif (dealId) base.hubspot_deal_id = String(dealId);\nelse base.project_slug = String(slug);\nreturn [{ json: { portalPayload: base } }];"
      },
      "id": "ce3de446-66ee-4c77-a1ef-229b131eaad8",
      "name": "Build add_invoice payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://portal.intrawebtech.com/api/webhook/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-intrawebtech-secret",
              "value": "n8n.intrawebtech.com/webhook/hubspot-events"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.portalPayload) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "b04e43d8-9992-4db9-8ffe-8e83e202ccd2",
      "name": "POST Portal /api/webhook/n8n",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        736,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "73e38b67-2206-415a-8803-659434387cc0",
      "name": "Respond JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.3,
      "position": [
        1168,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst statusCode = j.statusCode ?? j.status ?? 0;\nconst raw = j.body !== undefined && j.body !== null ? j.body : (j.data !== undefined ? j.data : '');\nconst str = typeof raw === 'string' ? raw : (typeof raw === 'object' ? JSON.stringify(raw) : String(raw));\nconst t = str.trim();\nif (!t) {\n  return [{ json: { ok: false, statusCode, error: 'empty_response' } }];\n}\ntry {\n  const parsed = JSON.parse(t);\n  return [{ json: typeof parsed === 'object' && parsed !== null ? { ...parsed, statusCode } : { result: parsed, statusCode } }];\n} catch (e) {\n  return [{ json: { ok: false, statusCode, error: 'response_not_json', message: e.message, rawPreview: t.slice(0, 4000) } }];\n}"
      },
      "id": "f8a2c1e0-9b3d-4a1e-8f2c-0d1e2f3a4b5c",

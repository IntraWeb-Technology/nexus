# Local secrets (gitignored): use `apps/iw-site-q2/.env.local` and `apps/iw-portal/.env.local`.
# Next.js loads monorepo root `.env.local` first (optional shared stub), then each app's own file.
# Never commit secrets.

# --- Shared / automation (iw-site-q2 + iw-portal + n8n scripts) ---
# n8n instance (portal: src/lib/n8n/client.ts; pull: pnpm --filter @repo/n8n-workflows pull:n8n → _synced-from-n8n/; sync curated JSON: sync:n8n:package)
# N8N_API_URL / N8N_BASE_URL: origin only (no trailing /api/v1). Node scripts use `${N8N_API_URL}/api/v1/...`.
# Exception — built-in **n8n** node (Credentials → n8n API → Base URL): must be the **full public API root**,
# e.g. https://n8n.intrawebtech.com/api/v1 (if you use N8N_PATH, insert it before /api/v1). Using the origin
# alone makes that node call /workflows on the wrong path and returns HTTP 404.
N8N_API_URL=https://n8n.intrawebtech.com
# API key: n8n → Settings → API (X-N8N-API-KEY). Required for pull:n8n / sync:n8n:package.
N8N_API_KEY=
# n8n project id for listing workflows (default IntraWeb OS). Set to `all` or leave empty value to list entire instance.
N8N_WORKFLOWS_PROJECT_ID=o5dYIcHW2mxs82d6
N8N_MCP_JSON=
N8N_BASE_URL=https://n8n.intrawebtech.com

# --- Webhook secrets (TWO separate secrets for different trust boundaries) ---
# WEBHOOK_SECRET — iw-portal ↔ n8n (bidirectional).
#   Sent by iw-portal outbound webhooks and validated by iw-portal on inbound calls from n8n.
#   Header name: x-intrawebtech-secret
#   Also gates internal OS APIs: GET /api/internal/os/... (same header).
WEBHOOK_SECRET=

# MARKETING_N8N_WEBHOOK_SECRET — iw-site-q2 → n8n only (website intake & contact forms).
#   Sent by iw-site-q2 in the header named by MARKETING_N8N_WEBHOOK_SECRET_HEADER.
#   Keep separate from WEBHOOK_SECRET so a marketing-site compromise cannot call portal internals.
#   (formerly N8N_WEBHOOK_SECRET — renamed for clarity)
MARKETING_N8N_WEBHOOK_SECRET=
MARKETING_N8N_WEBHOOK_SECRET_HEADER=X-Intraweb-Website-Intake-Secret
# Legacy alias still accepted by iw-site-q2 code — keep equal to MARKETING_N8N_WEBHOOK_SECRET during migration.
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET_HEADER=X-Intraweb-Website-Intake-Secret

N8N_CONTACT_WEBHOOK_URL=
# HubSpot dealstage for SYS 01 from marketing forms: builtin (e.g. appointmentscheduled) or numeric id for custom pipelines.
N8N_CONTACT_DEAL_STAGE=
N8N_KICKOFF_BOOKED_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_MS=55000
# Transactional email (marketing contact flow + portal)
RESEND_API_KEY=
# Optional: HTTPS URL for the logo in HTML emails (n8n CONFIG branding.logoUrl is primary for workflows; portal/iw-site-q2 use this or NEXT_PUBLIC_EMAIL_LOGO_URL)
EMAIL_LOGO_URL=https://www.intrawebtech.com/_next/image?url=%2Fintraweb-logo-white.png&w=384&q=75
# Optional: public logo URL for client-facing portal emails (falls back to EMAIL_LOGO_URL then production default)
NEXT_PUBLIC_EMAIL_LOGO_URL=https://www.intrawebtech.com/_next/image?url=%2Fintraweb-logo-white.png&w=384&q=75
# Optional: inverted / light-on-dark logo for email clients that honor prefers-color-scheme
EMAIL_LOGO_DARK_URL=
NEXT_PUBLIC_EMAIL_LOGO_DARK_URL=

# --- Marketing site (@repo/iw-site-q2, apps/iw-site-q2) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HUBSPOT_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_CAL_KICKOFF_CAL_LINK=
# HubSpot — canonical token for iw-site-q2 (CRM contacts + Forms API)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_FORM_GUID=
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_ENTERPRISE_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SKIP_IN_DEV=
# Optional 0–1 (default 0.5). Lower slightly (e.g. 0.35) only if legitimate users hit score_below_threshold in logs.
RECAPTCHA_MIN_SCORE=
# EMERGENCY ONLY (spam risk): if org policy blocks SA keys, set to true to skip server reCAPTCHA verify until WIF/keys exist. Remove ASAP.
CONTACT_INSECURE_SKIP_RECAPTCHA=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Claude API for lead tier classification (iw-site-q2 contact route)
ANTHROPIC_API_KEY=
CONTACT_EMAIL=
KICKOFF_BOOKING_JWT_SECRET=
WEBSITE_INTAKE_BYPASS_RECAPTCHA_SECRET=
WEBSITE_INTAKE_STRICT_N8N=

# Cal.com (kickoff slots + booking)
CAL_API_KEY=
NEXT_PUBLIC_SCHEDULE_URL=
NEXT_PUBLIC_ACCOUNTS_URL=

# --- Portal (@repo/iw-portal under apps/iw-portal) ---
NEXT_PUBLIC_APP_URL=https://dashboard.intrawebtech.com
# Clerk satellite (app on portal/dashboard.*, sign-in on accounts.*): IS_SATELLITE + sign-in/up URLs; DOMAIN optional (omit if multiple hostnames hit one deployment).
NEXT_PUBLIC_CLERK_IS_SATELLITE=
NEXT_PUBLIC_CLERK_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Satellite only: avoid `clerk.{dashboard}` DNS — same-origin FAPI proxy. See apps/iw-portal/README.md.
NEXT_PUBLIC_CLERK_PROXY_URL=
NEXT_PUBLIC_CLERK_SATELLITE_FAPI_PROXY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# iw-portal Supabase: API URL is https://<project-ref>.supabase.co (Dashboard → Settings → API). Use keys from the same project in apps/iw-portal/.env.local so CLI `supabase link`, migrate/seed, and the app all hit one database. Optional server-only duplicate of the API URL when your host only defines this name:
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# Deprecated/legacy aliases (avoid for new setups):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy alias — prefer SUPABASE_SERVICE_ROLE_KEY; this fallback is read by apps/iw-portal/src/lib/supabase/server.ts.
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
# Same value as Postgres "Database password" (Settings → Database). Used by `pnpm exec supabase migration list` / CLI login to the linked project.
SUPABASE_DB_PASSWORD=
SUPABASE_JWT_SECRET=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Portal: on `true`/`1`, Clerk `user.created` + first `session.created` create `clients` + starter `projects` (see apps/iw-portal/src/lib/data/provision-self-signup.ts). Point Clerk webhooks at `/api/webhook/clerk`.
PORTAL_AUTO_PROVISION_SIGNUPS=
CLERK_SUPABASE_JWT_TEMPLATE=supabase
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON array: portal Billing → maintenance price cards. Each: id, name, price_id (Stripe), optional plan_slugs (string[] — omit or ["*"] for all tiers; else must match projects.portal_plan_slug from HubSpot), optional description, price_cents, currency, billing_note, features (string[] checklist) or entitlements (alias). Example:
# STRIPE_MAINTENANCE_PACKAGES=[{"id":"essential","name":"Essential","plan_slugs":["growth"],"description":"Light support","price_id":"price_xxx","price_cents":9900,"currency":"usd","billing_note":"per month","features":["2 hrs / month","Email support","Security updates"]}]
STRIPE_MAINTENANCE_PACKAGES=
# Staff notification email (defaults to hardcoded address in code if unset — always set this in production)
STAFF_EMAIL=
HUBSPOT_PORTAL_ID=
# Portal HubSpot CRM — canonical token name. Set HUBSPOT_PRIVATE_APP_TOKEN.
# The portal also accepts HUBSPOT_ACCESS_TOKEN as a fallback for teams that already have it set.
# Private app must have CRM read/write scopes for deals, contacts, associations, and invoices.
HUBSPOT_PRIVATE_APP_TOKEN=
# HubSpot deal property internal name → mirrored to projects.portal_plan_slug (closed-set slug for maintenance plan_slugs). Create matching custom deal property in HubSpot.
HUBSPOT_DEAL_PORTAL_PLAN_PROPERTY=portal_plan_slug

# --- Platform (e.g. Vercel injects in hosted environments) ---
VERCEL_OIDC_TOKEN=
ANALYZE=

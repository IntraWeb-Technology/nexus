# Local secrets (gitignored): use `apps/iw-site/.env.local` and `apps/iw-portal/.env.local`.
# Next.js loads monorepo root `.env.local` first (optional stub), then each app’s file (see apps/*/next.config.js).
# Never commit secrets.

# --- Shared / automation (marketing site + portal + n8n scripts) ---
# n8n instance (portal: src/lib/n8n/client.ts; pull: pnpm --filter @repo/n8n-workflows pull:n8n → _synced-from-n8n/; sync curated JSON: sync:n8n:package)
N8N_API_URL=https://n8n.intrawebtech.com
# API key: n8n → Settings → API (X-N8N-API-KEY). Required for pull:n8n / sync:n8n:package.
N8N_API_KEY=
# n8n project id for listing workflows (default IntraWeb OS). Set to `all` or leave empty value to list entire instance.
N8N_WORKFLOWS_PROJECT_ID=o5dYIcHW2mxs82d6
N8N_MCP_JSON=
N8N_BASE_URL=https://n8n.intrawebtech.com
# HMAC / shared secret between apps and n8n webhooks (portal + marketing routes)
WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET_HEADER=X-Intraweb-Website-Intake-Secret
N8N_CONTACT_WEBHOOK_URL=
N8N_KICKOFF_BOOKED_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_MS=55000
# Transactional email (marketing contact flow + portal)
RESEND_API_KEY=

# --- Marketing site (@repo/iw-site, apps/iw-site) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HUBSPOT_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_CAL_KICKOFF_CAL_LINK=
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_FORM_GUID=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_ENTERPRISE_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SKIP_IN_DEV=
# Optional 0–1 (default 0.5). Lower slightly (e.g. 0.35) only if legitimate users hit score_below_threshold in logs.
RECAPTCHA_MIN_SCORE=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
ANALYZE=
ANTHROPIC_API_KEY=
CAL_API_KEY=
CONTACT_EMAIL=
DEBUG_PROMPTS=
KICKOFF_BOOKING_JWT_SECRET=
NEON_PROJECT_ID=
PGDATABASE=
PGHOST=
PGHOST_UNPOOLED=
PGPASSWORD=
PGUSER=
STACK_SECRET_SERVER_KEY=
WEBSITE_INTAKE_BYPASS_RECAPTCHA_SECRET=
WEBSITE_INTAKE_STRICT_N8N=

# Pooler / Postgres-style URLs (iw-site: Neon; iw-portal: Supabase — same var names, different values per app env file)
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=

# --- Portal (@repo/iw-portal under apps/iw-portal) ---
NEXT_PUBLIC_APP_URL=https://dashboard.intrawebtech.com
# Clerk satellite (app on portal/dashboard.*, sign-in on accounts.*): IS_SATELLITE + sign-in/up URLs; DOMAIN optional (omit if multiple hostnames hit one deployment).
NEXT_PUBLIC_CLERK_IS_SATELLITE=
NEXT_PUBLIC_CLERK_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Satellite only: avoid `clerk.{dashboard}` DNS — same-origin FAPI proxy. See apps/iw-portal/README.md.
NEXT_PUBLIC_CLERK_PROXY_URL=
NEXT_PUBLIC_CLERK_SATELLITE_FAPI_PROXY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_JWT_SECRET=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Portal: on `true`/`1`, Clerk `user.created` + first `session.created` create `clients` + starter `projects` (see apps/iw-portal/src/lib/data/provision-self-signup.ts). Point Clerk webhooks at `/api/webhook/clerk`.
PORTAL_AUTO_PROVISION_SIGNUPS=
CLERK_SUPABASE_JWT_TEMPLATE=supabase
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STAFF_EMAIL=
HUBSPOT_PORTAL_ID=
# Portal HubSpot CRM (deals, contacts, CRM invoices). Also accepts HUBSPOT_ACCESS_TOKEN or HUBSPOT_TOKEN if unset.
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Platform (e.g. Vercel injects in hosted environments) ---
VERCEL_OIDC_TOKEN=

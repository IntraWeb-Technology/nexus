# --- Portal (@repo/iw-portal under apps/iw-portal) ---
NEXT_PUBLIC_APP_URL=https://portal.intrawebtech.com
# Clerk satellite (portal on portal.*, sign-in on accounts.*): set all four or none. See apps/iw-portal/README.md.
NEXT_PUBLIC_CLERK_IS_SATELLITE=
NEXT_PUBLIC_CLERK_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=

{
  "framework": "nextjs",
  "installCommand": "pnpm -C clerk-nextjs install --frozen-lockfile",
  "buildCommand": "pnpm -C clerk-nextjs run build",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "portal.intrawebtech.com" }],
      "destination": "/:path*"
    }
  ]
}

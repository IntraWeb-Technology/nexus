#!/bin/sh
msg_file="$1"

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  exit 0
fi

terms="normalized standardized unified harmonized consolidated reusable simplified consistent consistency cleanup"

msg=$(cat "$msg_file")

for term in $terms; do
  if printf '%s' "$msg" | grep -qi "$term"; then
    printf '%s\n' "GOVERNANCE WARNING: Commit message contains normalization vocabulary: \"$term\"" >&2
    printf '%s\n' "This may indicate an authored property is being removed. Verify before merging." >&2
    printf '%s\n' "See QUICK-REFERENCE.md — Forbidden commit vocabulary section." >&2
  fi
done

exit 0
